# Copy to .env and fill in. Every credential is named with the HUMAN-TASK (§1)
# that supplies it. .env is gitignored; the same names are GitHub repo secrets.

# H1 — Congress.gov / api.data.gov key. https://api.congress.gov/sign-up/
# Blocks INC-1 (federal ingest).
CONGRESS_API_KEY=

# H2 — LegiScan key (free tier). https://legiscan.com/legiscan
# Blocks INC-1 state-branch verdict only.
LEGISCAN_API_KEY=

# H4 — Cloudflare Pages/Workers/D1 deploy (INC-9, INC-16).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# H6 — archive.org S3-like keys for authenticated Wayback Save-Page-Now (INC-11).
# Until present, curation falls back to unauthenticated SPN with a warning.
IA_S3_ACCESS=
IA_S3_SECRET=

# H7 — FEC key (optional INC-10b). The api.data.gov key above usually works;
# else register at https://api.open.fec.gov
FEC_API_KEY=

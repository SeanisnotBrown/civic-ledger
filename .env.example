# Copy to .env and fill in. Every credential is named with the HUMAN-TASK (§1)
# that supplies it. .env is gitignored; the same names are GitHub repo secrets.

# H1 — Congress.gov / api.data.gov key. https://api.congress.gov/sign-up/
# Blocks INC-1 (federal ingest).
CONGRESS_API_KEY=

# H2 — LegiScan key (free tier). https://legiscan.com/legiscan
# Blocks INC-1 state-branch verdict only.
LEGISCAN_API_KEY=

# H4 — Cloudflare Workers (Static Assets) deploy + D1 (INC-9 site, INC-16 worker).
# Site deploy is Workers Builds (auto on push, needs no CI secret); these are for
# the INC-16 aggregates Worker/D1 and any manual `wrangler deploy`.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# H6 — archive.org S3-like keys for authenticated Wayback Save-Page-Now (INC-11).
# Until present, curation falls back to unauthenticated SPN with a warning.
IA_S3_ACCESS=
IA_S3_SECRET=

# H7 — FEC key (optional INC-10b). The api.data.gov key above usually works;
# else register at https://api.open.fec.gov
FEC_API_KEY=

# H8 — Anthropic API key (Phase 3 statements pipeline). https://platform.claude.com/
# Blocks EVERY AI call from Phase 3 task 1 onward: triage, categorizer, bill summaries.
# Read via ingest/env.py; `ingest/ai.py` is the only module that uses it.
ANTHROPIC_API_KEY=

REVIEW_LOG_BACKUP_REMOTE=

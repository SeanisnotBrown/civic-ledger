# Secrets
.env

# Raw source cache and build DB are dev conveniences; the PUBLISHED dataset is
# the exported JSON/YAML under data/ (§4). uv.lock and site/package-lock.json
# are intentionally NOT ignored — they pin the reproducible build.
data/raw/
build.db

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Node / Astro
node_modules/
dist/
site/dist/
.astro/

# Playwright (e2e artifacts + downloaded browsers)
site/test-results/
site/playwright-report/
site/.playwright/

# Lighthouse CI output
site/.lighthouseci/

# Coverage artifacts (§8 gate; V2-2)
.coverage
.coverage.*
htmlcov/

# dotnet-suggest CLI junk (unrelated to this project, created by the .NET SDK)
system-commandline-sentinel-files/

# Local backfill run logs (V2-11). The run itself is local-only by design (H24);
# its log is a transcript of this machine, not part of the dataset.
backfill-*.log

# Session wrap-up gate output (local, regenerated every /wrapup run)
wrap.log

---
// One item in the "In Congress" band and on its full list. The government's action
// text is rendered VERBATIM; the bill's official title sits above it, because the
// action text alone often does not say what was voted on. `tierLabel` is a factual
// restatement of the action's own outcome and tally — never a characterisation.
//
// The bill link follows the SD-33 3(c) rule: /b/{id} only when that page exists
// (the bill reached a recorded vote), otherwise the bill's own congress.gov page.
//
// `compact` is the homepage band: the title and the action text are each clamped
// to two lines (the expand control comes from Layout, and with JavaScript off
// nothing is clamped) and the policy area is dropped. Nothing is REMOVED in
// compact mode -- the homepage says every line is the government's own action
// text, so the action text is on the line either way. /congress is not compact.
import type { ActivityRow } from "../lib/data";
import { formatDate, billLabel } from "../lib/display";

interface Props { row: ActivityRow; compact?: boolean }
const { row, compact = false } = Astro.props as Props;
const e = row.event;
const href = e.has_page ? `/b/${e.bill_id}` : e.source_url;
// Tiers 1-3 are the consequential end of the ratified order — the two recorded-vote
// tiers and what became law. The accent marks them so the lead reads as the lead.
const lead = row.tier <= 3;
---
<li class={`border-t border-line first:border-0 ${compact ? "py-2.5" : "py-3"}`}>
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <span class={`rounded px-1.5 py-0.5 text-[11px] ${lead
      ? "bg-accent/15 text-accent-300"
      : "bg-surface text-neutral-600"}`}>{row.tierLabel}</span>
    <span class="text-[12px] text-neutral-500">
      <a href={href} rel={e.has_page ? undefined : "nofollow"}
         class="underline decoration-line underline-offset-2 hover:text-text">{billLabel(e.bill_id)}</a>
      <span aria-hidden="true"> · </span>
      <span class="tabular-nums">{formatDate(e.date)}</span>
      {!compact && e.policy_area && <><span aria-hidden="true"> · </span>{e.policy_area}</>}
    </span>
  </div>
  {row.title && <p class="mt-1.5 text-[13px] leading-snug text-text" data-clamp>{row.title}</p>}
  <p class="mt-1 text-[12px] leading-relaxed text-neutral-600" data-clamp={compact ? true : undefined}>{e.text}</p>
  {row.margin && (
    <p class="mt-1 text-[11px] text-neutral-500">
      {row.margin.sharePct}% of the yea/nay votes cast were on the winning side —
      {" "}<a href={`/v/${row.margin.rollcallId}`} class="underline decoration-line underline-offset-2 hover:text-text">see the roll call</a>.
    </p>
  )}
</li>

---
// Shared page shell + the footer (on every page): data-last-updated, methodology
// and corrections links.
// Nocturne dark theme (owner's design pass, 2026-08-14): 1180px container, sticky nav,
// self-hosted Inter. Colour lives in the tokens in styles/global.css.
//
// P2 (§4.9) removed three things from this shell: the States tab, the threat-model
// link, and the build commit in the footer. The routes behind them are all still
// built and still reachable by URL; only the navigation to them is gone, because
// the reader does not need them to use the site. The "every published fact links to
// an official source" line went with them — the site earns that by the links
// working when you click them, not by claiming it in a footer.
import "../styles/global.css";
import { getManifest, getSenateOutage } from "../lib/data";
import { formatDate, senateOutageLine } from "../lib/display";

interface Props { title: string; description?: string }
const { title, description } = Astro.props;

const manifest = getManifest();
const updated = formatDate(manifest.generated_at);
const senateOutage = getSenateOutage();

// Primary tabs. `match` decides the active tab from the current path so a detail
// page still highlights its section: a federal member/vote/bill page lights
// "Members" (the owner's label, 2026-10-07 -- the ROUTE stays /federal, which
// every member-page back link and the grade-band deep links depend on). Home is
// active only on the exact root. aria-current="page" marks it
// for assistive tech.
const path = Astro.url.pathname;
const TABS: { href: string; label: string; match: (p: string) => boolean }[] = [
  { href: "/", label: "Home", match: (p) => p === "/" },
  { href: "/federal", label: "Members",
    match: (p) => ["/federal", "/m/", "/v/", "/b/", "/topics", "/compare", "/pairing"].some((x) => p === x || p.startsWith(x)) },
  { href: "/methods", label: "Methodology", match: (p) => p.startsWith("/methods") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? "The legislative record of the U.S. Congress: votes, bills, and attendance, from the official account."} />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/atom+xml" title="Civic Ledger — legislative activity" href="/feed.xml" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-bg text-text antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-surface focus:p-2">Skip to content</a>

    <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
      <nav class="mx-auto flex max-w-[1180px] flex-wrap items-center gap-x-7 gap-y-2 px-6 py-3.5 text-sm" aria-label="Primary">
        <a href="/" class="mr-auto font-medium tracking-tight text-text">Civic Ledger</a>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-1">
          {TABS.map((t) => {
            const active = t.match(path);
            return (
              <li>
                <a href={t.href} aria-current={active ? "page" : undefined}
                   class={active
                     ? "text-accent-300"
                     : "text-neutral-500 transition-colors hover:text-text"}>
                  {t.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>

    <main id="main" class="mx-auto max-w-[1180px] px-6 py-10">
      <slot />
    </main>

    <footer class="mx-auto max-w-[1180px] px-6 py-10 text-xs text-neutral-500">
      <p>Data last updated {updated}.</p>
      {senateOutage && <p class="mt-1.5">{senateOutageLine(senateOutage)}</p>}
      <p class="mt-1.5 flex flex-wrap items-center gap-x-2">
        <a href="/methods" class="text-neutral-500 underline decoration-line underline-offset-2 hover:text-text">Methodology</a>
        <span aria-hidden="true">·</span>
        <a href="/corrections" class="text-neutral-500 underline decoration-line underline-offset-2 hover:text-text">Corrections</a>
        <span aria-hidden="true">·</span>
        <a href="/privacy" class="text-neutral-500 underline decoration-line underline-offset-2 hover:text-text">Privacy</a>
      </p>
    </footer>

    <script>
      // Two-line clamp with an expand control (owner, 2026-10-07: bill titles are
      // long enough to bury the rest of a row). Nothing is clamped server-side:
      // with JavaScript off every title renders in full, which is the content.
      // The button is added only where the text really overflows two lines, so a
      // short title never grows a pointless control.
      //
      // THREE PASSES, NOT ONE, and the reason is the Lighthouse gate. The original
      // loop added the class and then read `scrollHeight` on the SAME element before
      // moving on. A style write followed by a layout read forces the browser to
      // recompute layout synchronously, every iteration — and `/m/A000055/1` carries
      // 283 of these, so it was 283 full layouts of a 5,474-element document on the
      // main thread, which is Total Blocking Time and 30% of the performance score.
      // Writing all the classes, then reading all the measurements, then writing all
      // the results costs ONE layout: the first read in pass two forces it, and the
      // rest are free because nothing invalidates it in between. The decision each
      // element gets, and therefore the rendered result, is identical.
      const clamped = [...document.querySelectorAll<HTMLElement>("[data-clamp]")];
      for (const el of clamped) el.classList.add("line-clamp-2");
      // One forced layout happens here, on the first read, and serves all of them.
      const overflowing = clamped.map((el) => el.scrollHeight > el.clientHeight + 1);
      for (const [i, el] of clamped.entries()) {
        if (!overflowing[i]) {
          el.classList.remove("line-clamp-2");
          continue;
        }
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          "mt-0.5 text-[11px] text-neutral-500 underline decoration-line underline-offset-2 hover:text-text";
        btn.setAttribute("aria-expanded", "false");
        const label = () => {
          const open = btn.getAttribute("aria-expanded") === "true";
          btn.textContent = open ? "Show less" : "Show the full title";
        };
        label();
        btn.addEventListener("click", () => {
          const open = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", open ? "false" : "true");
          el.classList.toggle("line-clamp-2", open);
          label();
        });
        el.insertAdjacentElement("afterend", btn);
      }
    </script>
  </body>
</html>

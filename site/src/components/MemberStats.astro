---
// INC-13 (member-page metric rendering, D38) + V2-3 (rank context). A KPI row of stat
// tiles surfacing the already-computed Tier-2 metrics (data/metrics.json) on a member's
// page, each with its rank within the chamber (data/rankings, V2-2). Discipline:
//   * every figure is shown WITH its denominator/context — never a bare count (D38);
//   * rank context is a factual POSITION within the chamber (Nth of M, percentile),
//     NOT a grade — V2-3 adds ranks; the attendance letter grade is V2-4 (SD-26);
//   * NOTHING is combined into a single per-member score (only attendance is graded;
//     the overall composite is still owner-deferred — no unratified formula publishes);
//   * colour-as-meaning: since D74 (2026-08-14, the design pass) the attendance grade
//     badge is tinted with its ratified band colour. The colour is added AROUND the
//     verbatim, owner-ratified label (never instead of it — the §6.8 grade-labels guard
//     still checks the exact string); every figure and rank links to its methodology.
// Values mirror the pydantic metric models; pct is null on a zero denominator (R-4).

import type { MemberRank, MemberGrade } from "../lib/data";

interface Attendance { eligible: number; cast: number; missed: number; pct: number | null }
interface PartyUnity { substantive: number; agreed: number; pct: number | null; excluded_ties: number }
interface Count { count: number }
interface Enacted { sponsored: number; enacted: number; pct: number | null }
interface Gap { bill_id: string; kind: string; rollcall_id: string | null }

interface Props {
  metrics: Record<string, unknown>;
  periodLabel: string; // e.g. "118th–119th Congresses" or "2026 Regular Session"
  jurisdiction?: "us" | "ms";
  // V2-3: per-metric rank within the chamber; a key is present only when the member is
  // ranked on it (absent for a null value, or a delegate on a vote metric — D66). MS
  // members have no federal rankings, so this is undefined for them.
  ranks?: Record<string, MemberRank>;
  chamberWord?: string; // "House" / "Senate" — the noun the rank line reads "of N in the …"
  // V2-3: true when the member is a non-voting delegate excluded from the vote-metric
  // rankings (D66) — drives the explanatory caption clause where their tiles lack a rank.
  isDelegate?: boolean;
  // V2-4: the member's attendance grade (ratified thresholds). Present on federal
  // pages; undefined for MS (no state grades yet). Either a graded {grade,label} or a
  // set-aside {exception,exceptionLabel}.
  grade?: MemberGrade;
}
const { metrics, periodLabel, jurisdiction = "us", ranks, chamberWord = "chamber",
        isDelegate = false, grade } = Astro.props as Props;
const isMs = jurisdiction === "ms";

// 1 → "1st", 2 → "2nd", 12 → "12th" (factual ordinal for rank + percentile).
const ordinal = (x: number): string => {
  const v = x % 100;
  const suffix = v >= 11 && v <= 13 ? "th" : (["th", "st", "nd", "rd"][x % 10] ?? "th");
  return `${x.toLocaleString("en-US")}${suffix}`;
};

const att = metrics.attendance as Attendance;
const pu = metrics.party_unity as PartyUnity;
const spon = metrics.sponsored as Count;
const cospon = metrics.cosponsored as Count;
const enact = metrics.enacted_rate as Enacted;
const gaps = (metrics.cosponsor_vote_gap as Gap[]) ?? []; // federal-only; MS has none

const n = (x: number) => x.toLocaleString("en-US");
const pct = (x: number | null) => (x == null ? "—" : `${x}%`);

// Methodology anchor: federal has a per-metric section; MS shares one limitations section.
const href = (key: string) => (isMs ? "/methods#mississippi" : `/methods#metric-${key}`);
const methodsLink = isMs ? "/methods#mississippi" : "/methods";

// D74: the attendance grade badge is tinted with its ratified band colour (added
// AROUND the verbatim label, never replacing it). Hexes mirror --color-grade-* in
// global.css; keyed by the ratified letter grade.
const GRADE_HEX: Record<string, string> = {
  A: "#7fbf9a", B: "#9184d9", C: "#c9b06a", D: "#d99a6b", F: "#d96b7a",
};

const votedNay = gaps.filter((g) => g.kind === "cosponsored_and_voted_nay").length;
const noFloor = gaps.filter((g) => g.kind === "cosponsored_no_floor_action").length;

// label · value · context(denominator) · methodology anchor
const tiles = [
  { key: "attendance", label: "Attendance", value: pct(att.pct),
    context: att.pct == null ? "no eligible roll calls yet"
      : `voted on ${n(att.cast)} of ${n(att.eligible)} eligible roll calls` },
  { key: "party_unity", label: "Party unity", value: pct(pu.pct),
    context: pu.pct == null ? "no substantive votes yet"
      : `with their party's majority on ${n(pu.agreed)} of ${n(pu.substantive)} substantive votes` },
  { key: "sponsored", label: isMs ? "Bills authored" : "Bills sponsored", value: n(spon.count),
    context: periodLabel },
  { key: "cosponsored", label: isMs ? "Bills co-authored" : "Bills cosponsored",
    value: n(cospon.count), context: periodLabel },
  { key: "enacted_rate", label: "Became law", value: `${n(enact.enacted)} of ${n(enact.sponsored)}`,
    context: isMs ? "authored bills approved by the Governor"
      : "sponsored bills enacted under their own bill number" },
];
---
<section class="mt-6" aria-labelledby="stats-h">
  <h2 id="stats-h" class="text-sm font-semibold uppercase tracking-wide text-neutral-500">
    Record summary
  </h2>
  <p class="mt-1 max-w-prose text-xs text-neutral-500">
    Each figure is a plain count or rate shown with its denominator{!isMs && ", its rank within the chamber, and — for attendance — a letter grade against fixed, published thresholds"}.{isDelegate && " As a non-voting delegate, they are not ranked or graded on attendance or party unity, which require voting on final passage; they are ranked on the bill measures."} The site combines
    nothing into an overall score{isMs && " and draws no conclusion"} — see
    <a href={methodsLink} class="underline hover:text-neutral-700">how each is computed</a>.
  </p>

  <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-4 sm:grid-cols-3 lg:grid-cols-5">
    {tiles.map((t) => {
      const r = ranks?.[t.key];
      return (
        <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-3">
          <dt class="text-xs font-medium text-neutral-500">
            <a href={href(t.key)} class="hover:text-neutral-700 hover:underline">{t.label}</a>
          </dt>
          <dd class="mt-1 text-2xl font-semibold tracking-tight text-neutral-900">{t.value}</dd>
          {t.key === "attendance" && grade?.grade && (
            <dd class="mt-1">
              <a href="/methods#grade-attendance"
                 style={`background:${GRADE_HEX[grade.grade]}1f;border-color:${GRADE_HEX[grade.grade]}66`}
                 class="inline-flex items-center gap-1.5 rounded border px-2 py-0.5 text-sm font-medium text-text transition-opacity hover:opacity-80">
                <span aria-hidden="true" class="inline-block h-2 w-2 rounded-full" style={`background:${GRADE_HEX[grade.grade]}`}></span>
                <span data-grade-label>{grade.label}</span>
              </a>
            </dd>
          )}
          {/* Set-aside note only for a thin/absent record; a delegate's exclusion (D66)
              is explained by the caption above, not repeated as "too few votes" here. */}
          {t.key === "attendance" && grade?.exception && grade.exception !== "delegate" && (
            <dd class="mt-1 text-xs italic text-neutral-500"><span data-grade-label>{grade.exceptionLabel}</span></dd>
          )}
          {r && (
            <dd class="mt-0.5 text-xs font-medium text-neutral-600">
              <a href={`/methods#ranking-${t.key}`} class="hover:text-neutral-800 hover:underline">
                {ordinal(r.rank)} of {n(r.covered)} in the {chamberWord}
              </a>
            </dd>
          )}
          <dd class="mt-0.5 text-xs leading-snug text-neutral-500">{t.context}</dd>
        </div>
      );
    })}
  </dl>

  <p class="mt-2 max-w-prose text-xs text-neutral-500">
    {isMs
      ? "\"Became law\" counts bills the member principally authored that the Governor approved this session; \"authored\" and \"co-authored\" follow the order Mississippi lists a bill's authors (LegiScan does not mark a single primary author)."
      : "\"Became law\" counts only bills enacted under the member's own bill number; much enacted text moves by being folded into another bill, which this figure cannot and does not attribute."}
  </p>

  {gaps.length > 0 && (
    <details class="mt-2 max-w-prose text-xs text-neutral-600">
      <summary class="cursor-pointer text-neutral-500 hover:text-neutral-700">
        Cosponsorship-and-vote adjacencies ({n(gaps.length)}) — not a score
      </summary>
      <p class="mt-1">
        Of {n(cospon.count)} cosponsored bills: {n(votedNay)} where the member later
        voted Nay on passage, and {n(noFloor)} in a concluded Congress that received no
        recorded floor vote. Most introduced bills never receive a floor vote, and floor
        scheduling is set by chamber leadership, not a bill's cosponsors — this list is
        for inspection, not a judgment about the member.
      </p>
    </details>
  )}
</section>

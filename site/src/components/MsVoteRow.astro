---
// One row in a MS legislator's vote list (INC-12). Same §6.7 contract as the federal
// VoteRow — position, date, roll #, vote_class badge, verbatim question, bill link,
// official-record link — but routed to the /ms/ pages. MS has no personal-explanation
// pipeline, so a Not-voting row carries no CREC line (the position label says it plainly).
import type { Position, RollCall } from "../lib/data";
import Badge from "./Badge.astro";
import { POSITION_LABEL, formatDate, msBillLabel } from "../lib/display";

interface Props { rollcall: RollCall; position: Position }
const { rollcall: rc, position } = Astro.props;
---
<li class="border-b border-neutral-100 py-3">
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <span class="font-semibold">{POSITION_LABEL[position]}</span>
    <Badge voteClass={rc.vote_class} />
    <span class="text-xs text-neutral-500">
      {formatDate(rc.date)} · Roll <a href={`/ms/v/${rc.id}`} class="underline hover:text-neutral-800">#{rc.number}</a>
    </span>
  </div>
  <p class="mt-1 text-sm text-neutral-800">{rc.question}</p>
  <div class="mt-1 flex flex-wrap gap-x-3 text-xs text-neutral-500">
    {rc.bill_id && (
      <a href={`/ms/b/${rc.bill_id}`} class="underline hover:text-neutral-800">{msBillLabel(rc.bill_id)}</a>
    )}
    <a href={rc.source_url} rel="nofollow" class="underline hover:text-neutral-800">Vote record (LegiScan)</a>
  </div>
</li>

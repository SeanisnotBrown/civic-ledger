---
// One statement on a member timeline (INC-11). §6.7 pairing contract: the statement
// is verbatim; any paired vote is rendered visually adjacent with a connected marker
// and ZERO relational language — no "despite", "but", "however", no claim that the two
// conflict or occurred in any order. The site states the pairing rule and draws no
// conclusion (see /pairing). Pairing is READ from `paired_bill_ids` (Python, D9/D41).
import type { Statement, PairedVote } from "../lib/data";
import Badge from "./Badge.astro";
import { POSITION_LABEL, formatDate, billLabel } from "../lib/display";

interface Props { statement: Statement; pairedVotes: PairedVote[] }
const { statement: s, pairedVotes } = Astro.props;
---
<li class="border-b border-neutral-100 py-3">
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <span class="rounded bg-neutral-100 px-1.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-neutral-600">Statement</span>
    <span class="text-xs text-neutral-500">{formatDate(s.date)} · {s.venue}</span>
  </div>
  <blockquote class="mt-1 border-l-2 border-neutral-200 pl-3 text-sm italic text-neutral-800">“{s.text}”</blockquote>
  <div class="mt-1 flex flex-wrap gap-x-3 text-xs text-neutral-500">
    <a href={s.source_url} rel="nofollow" class="underline hover:text-neutral-800">Source</a>
    <a href={s.archive_url} rel="nofollow" class="underline hover:text-neutral-800">Archived copy</a>
    {s.named_measures.length > 0 && (
      <span>Names: {s.named_measures.join(", ")}</span>
    )}
  </div>

  {pairedVotes.length > 0 && (
    <div class="mt-2 border-l-2 border-neutral-300 pl-3">
      <p class="text-xs font-medium text-neutral-500">
        Recorded vote on the named measure (<a href="/pairing" class="underline hover:text-neutral-800">how pairing works</a>):
      </p>
      <ul class="mt-1">
        {pairedVotes.map((pv) => (
          <li class="flex flex-wrap items-baseline gap-x-2 py-1 text-sm">
            <span class="font-semibold">{POSITION_LABEL[pv.position]}</span>
            <Badge voteClass={pv.rollcall.vote_class} />
            <span class="text-xs text-neutral-500">
              {formatDate(pv.rollcall.date)} · Roll <a href={`/v/${pv.rollcall.id}`} class="underline hover:text-neutral-800">#{pv.rollcall.number}</a>
              {pv.rollcall.bill_id && (<>{" · "}<a href={`/b/${pv.rollcall.bill_id}`} class="underline hover:text-neutral-800">{billLabel(pv.rollcall.bill_id)}</a></>)}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )}
</li>

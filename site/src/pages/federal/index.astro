---
// V2-5 Nocturne — the members explorer (README screen 2). The full 637-member roster is a
// multi-metric grid rendered as STATIC HTML: crawlable, correct with JavaScript off,
// byte-deterministic. The MemberBrowser island hydrates only the controls and enhances
// this grid in place — filtering by row `display`, sorting by reordering rows, hiding
// columns by `data-col` — all from each row's `data-*`. It never owns the rows (D73).
//
// This is an ARIA grid of <div>s, NOT a <table> — deliberately (D78). `content-visibility:
// auto` on each row lets the browser skip layout/paint for the ~620 off-screen rows, which
// is the only thing that keeps 637 rich rows inside the CI mobile-Lighthouse budget. That
// containment optimisation CANNOT apply to <tr>/table-row-group boxes (they can't establish
// layout containment), so a real table measured perf 0.77 on the CI runner; block-level
// rows measured well under the budget. Column definitions come from ingest/metrics.py
// docstrings via getExplorerColumns.
import Layout from "../../components/Layout.astro";
import MemberBrowser from "../../components/MemberBrowser.tsx";
import { getMembers, getMemberGrade, getManifest } from "../../lib/data";
import { getExplorerColumns } from "../../lib/columns";
import { ordinal } from "../../lib/display";

const members = getMembers(); // already name-sorted (localeCompare)
const manifest = getManifest();
const columns = getExplorerColumns(members.map((m) => m.id));

const PARTY_INITIAL: Record<string, string> = { D: "D", R: "R", I: "I" };
const PARTY_COLOR: Record<string, string> = {
  D: "var(--color-party-d)", R: "var(--color-party-r)", I: "var(--color-party-i)",
};

const rows = members.map((m) => {
  const g = getMemberGrade(m.id);
  const exceptionLabel = g?.exception && g.exception !== "delegate" ? g.exceptionLabel ?? null : null;
  const cells = columns.map((c) => ({ key: c.key, barClass: c.barClass, ...c.cellFor(m.id) }));
  return {
    id: m.id, name: m.name, party: m.party, state: m.state, district: m.district,
    chamber: m.chamber,
    gradeLetter: g?.grade ?? null, gradeLabel: g?.label ?? null, exceptionLabel, cells,
  };
});

const congresses = manifest.congresses ?? [];
const periodLabel = congresses.length
  ? `the ${ordinal(congresses[0])}–${ordinal(congresses[congresses.length - 1])} Congresses`
  : "the covered Congresses";
const fmtInt = (x: number) => x.toLocaleString("en-US");
---
<Layout title="Civic Ledger — Federal members" description="Every member of the U.S. House and Senate — attendance, party unity, vote mix, and legislative output, sortable and filterable.">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div class="flex flex-wrap items-end gap-x-3 gap-y-1">
      <h1 class="text-[32px] font-medium tracking-[-0.025em]">Members explorer</h1>
      <p class="text-[13px] text-neutral-500">{fmtInt(members.length)} members · {periodLabel}</p>
    </div>
    {/* The MemberBrowser island sets href/count and unhides this once two members are picked
       for comparison. Static <a hidden> so it's a real link (no author display, so the UA
       [hidden]{display:none} applies cleanly) and JS-off it simply stays hidden. */}
    <a
      id="mb-compare"
      href="/compare"
      hidden
      class="rounded-md border border-accent bg-[rgba(145,132,217,0.15)] px-3 py-1.5 text-[13px] font-medium text-text hover:bg-[rgba(145,132,217,0.24)]"
    >Compare selected (<span data-cmp-n>0</span>)</a>
  </div>
  <p class="mt-2 max-w-[62ch] text-[15px] leading-[1.6] text-neutral-700">
    Every member of the U.S. House and Senate serving in {periodLabel}. Filter by chamber,
    party or attendance grade, search by name or state, and sort by any column. Attendance
    is graded A–F against fixed thresholds
    <a href="/methods#grade-attendance" class="text-accent-300 underline underline-offset-2">published on the methodology page</a>;
    the same standard applies to everyone. Non-voting delegates appear but are not graded on
    attendance — they cannot vote on final passage, so their record is not comparable.
  </p>

  <MemberBrowser client:idle total={members.length} columns={columns.map((c) => ({ key: c.key, short: c.short }))} />

  <div class="mt-4 overflow-x-auto rounded-lg border border-line bg-surface">
    <div id="member-list" role="table" aria-label="Federal members" class="ledger text-left">
      <div role="row" class="hrow border-b border-line">
        <div role="columnheader" class="cell c-name th-lbl">
          <button type="button" data-sort="name" class="hdr-btn">Member<span class="arrow" aria-hidden="true"></span></button>
        </div>
        <div role="columnheader" class="cell c-seat th-lbl">Seat</div>
        <div role="columnheader" class="cell c-grade th-lbl">
          <button type="button" data-sort="grade" class="hdr-btn">Grade<span class="arrow" aria-hidden="true"></span></button>
        </div>
        {columns.map((c) => (
          <div role="columnheader" data-col={c.key} aria-sort="none" class="cell c-metric th-lbl" title={c.def}>
            <button type="button" data-sort={c.key} class="hdr-btn tabular-nums">{c.short}<span class="arrow" aria-hidden="true"></span></button>
            <span class="sub tabular-nums">med {c.median}</span>
          </div>
        ))}
      </div>

      {rows.map((r) => (
        <div
          role="row"
          data-member
          data-id={r.id}
          data-chamber={r.chamber}
          data-party={r.party}
          data-grade={r.gradeLetter ?? ""}
          data-name={r.name}
          data-search={`${r.name} ${r.state}`.toLowerCase()}
          data-att={r.cells[0].sort ?? ""}
          data-unity={r.cells[1].sort ?? ""}
          data-yea={r.cells[2].sort ?? ""}
          data-spon={r.cells[3].sort ?? ""}
          data-cospon={r.cells[4].sort ?? ""}
          data-law={r.cells[5].sort ?? ""}
          class="row border-b border-line-soft"
        >
          <div role="cell" class="cell c-name">
            <a href={`/m/${r.id}/1`} class="font-medium text-text underline decoration-transparent underline-offset-2 hover:decoration-line">{r.name}</a>
          </div>
          <div role="cell" class="cell c-seat whitespace-nowrap text-[12px] text-neutral-500">
            <span class="dot" aria-hidden="true" style={`background:${PARTY_COLOR[r.party]}`}></span>{PARTY_INITIAL[r.party]} · {r.state}{r.district != null ? `-${r.district}` : ""}
          </div>
          <div role="cell" class:list={["cell c-grade gr text-[13px] tabular-nums", r.gradeLetter ? `gr-${r.gradeLetter}` : ""]}>
            {r.gradeLetter ?? "—"}
            {r.gradeLabel ? (
              <span class="sr-only" data-grade-label>{r.gradeLabel}</span>
            ) : r.exceptionLabel ? (
              <span class="sr-only" data-grade-label>{r.exceptionLabel}</span>
            ) : (
              <span class="sr-only">Not graded</span>
            )}
          </div>
          {r.cells.map((c) => (
            <div
              role="cell"
              data-col={c.key}
              class:list={["cell c-metric mc text-[12px] tabular-nums", c.barClass]}
              style={c.barColor ? `--f:${c.fill}%;--bar:${c.barColor}` : `--f:${c.fill}%`}
            >{c.display}{c.fraction && <i>{c.fraction}</i>}</div>
          ))}
        </div>
      ))}
    </div>
  </div>

  <section class="mt-4 rounded-lg border border-line bg-surface p-5" aria-labelledby="defs-h">
    <h2 id="defs-h" class="text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">What each column counts</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {columns.map((c) => (
        <div data-col={c.key} class="border-l-2 border-accent-700 pl-3">
          <div class="text-[13px] text-text">{c.full} <span class="text-neutral-500">· scale {c.domain}</span></div>
          <p class="mt-0.5 text-[12px] leading-relaxed text-neutral-500">{c.def}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* An ARIA grid of divs (NOT a <table>) so `content-visibility` can skip off-screen rows —
     table-row boxes cannot establish layout containment, which is why the real-table build
     measured 0.77 on CI (D78). Rows are flex; cells have fixed flex bases so columns line up
     without the browser measuring every row (which pairs with content-visibility). */
  .ledger { min-width: 960px; }
  .hrow, .row { display: flex; align-items: stretch; }
  .cell { padding: 8px; min-width: 0; }

  /* Interactive control gutters — compare-select (left, 30px) and exclude (right, 24px) —
     are reserved STATICALLY so the MemberBrowser island can drop absolutely-positioned
     controls into them on hydration with ZERO layout shift (the flex row never reflows;
     CLS is 25% of the mobile-perf score, D78's runner fails at the margin). JS-off the
     gutters are simply empty. The controls are role="cell"/columnheader wrappers so the
     ARIA grid keeps a valid child structure (a bare <button> child of role="row" fails
     axe aria-required-children). */
  .hrow, .row { position: relative; padding-left: 30px; padding-right: 24px; }
  .c-cmp, .c-excl { position: absolute; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; }
  .c-cmp { left: 0; width: 30px; }
  .c-excl { right: 0; width: 24px; }
  .c-cmp button, .c-excl button {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; border-radius: 4px; font-size: 12px; line-height: 1;
    color: var(--color-neutral-500);
  }
  .c-cmp button:hover, .c-excl button:hover { color: var(--color-text); background: rgba(233,233,237,0.08); }
  .c-cmp button[aria-pressed="true"] { color: var(--color-accent-300); box-shadow: inset 0 0 0 1px var(--color-accent); }
  .c-name { flex: 1 1 150px; min-width: 150px; display: flex; align-items: center; }
  .c-seat { flex: 0 0 108px; display: flex; align-items: center; }
  .c-grade { flex: 0 0 58px; display: flex; align-items: center; }
  .c-metric { flex: 0 0 92px; display: flex; flex-direction: column; align-items: flex-end; justify-content: center; text-align: right; }
  .hrow .c-metric { justify-content: flex-end; }

  /* Skip layout + paint for the ~620 off-screen rows. `auto` remembers each row's real
     height after first render; the header row is NEVER contained. */
  .row { content-visibility: auto; contain-intrinsic-size: auto 38px; }
  .row:hover { background: rgba(233,233,237,0.05); }

  .th-lbl { font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-neutral-500); }
  .hrow .cell { padding-top: 10px; padding-bottom: 10px; }
  .hdr-btn { display: inline-flex; align-items: center; gap: 4px; color: var(--color-neutral-500); }
  .hdr-btn:hover { color: var(--color-text); }
  .hdr-btn[data-active] { color: var(--color-accent-300); }
  .hdr-btn[data-active][data-dir="desc"] .arrow::after { content: " \2193"; }
  .hdr-btn[data-active][data-dir="asc"] .arrow::after { content: " \2191"; }
  .sub { display: block; margin-top: 2px; font-size: 10px; color: var(--color-neutral-500); }

  .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 6px; flex: none; }

  /* grade cell: neutral letter (keeps AA contrast) + a subtle band tint conveying colour. */
  .gr { color: var(--color-text); }
  .gr-A { background: rgba(127,191,154,0.12); }
  .gr-B { background: rgba(145,132,217,0.14); }
  .gr-C { background: rgba(201,176,106,0.12); }
  .gr-D { background: rgba(217,154,107,0.12); }
  .gr-F { background: rgba(217,107,122,0.13); }

  /* metric cell: value + optional fraction, with a magnitude bar drawn as ::before
     (0 DOM nodes) at the bottom of the cell. */
  .mc { position: relative; color: rgba(233,233,237,0.85); }
  .mc i { font-style: normal; margin-left: 4px; font-size: 10px; color: var(--color-neutral-500); }
  .mc::before {
    content: ""; position: absolute; left: 0; bottom: 0; height: 3px;
    width: var(--f, 0%); background: var(--bar, var(--color-accent));
    opacity: 0.85; border-radius: 0 2px 2px 0;
  }
  .bar-acc { --bar: var(--color-accent); }
  .bar-unity { --bar: var(--color-accent-300); }
  .bar-yea { --bar: var(--color-pos-yea); }
</style>

---
// P2 homepage (IMPLEMENTATIONv3.md §4.1), in the owner's order (2026-10-07):
// intro → In Congress → the rep finder → statistics.
//
// The intro is the owner's own ratified Q-A text. He struck its closing line
// ("Find your representatives below.") once the finder moved below the Congress
// band, where that sentence would have pointed past it.
//
// The Congress band is ONE ranked list (owner, 2026-10-07): four equal-weight boxes
// made a calendar placement look as important as a bill becoming law. The ranking
// rule is in recentChamberActivity and written out for the reader on /congress.
//
// §4.9 cuts applied here: the roll-calls-by-class panel, the chamber bar chart, the
// dataset count tiles, and the States card are gone. The attendance distribution is
// NOT a cut — it sits in the statistics area, where it still reproduces each band
// as a link into the federal list.
import Layout from "../components/Layout.astro";
import Histogram from "../components/charts/Histogram.astro";
import BandLegend from "../components/charts/BandLegend.astro";
import ActivityItem from "../components/ActivityItem.astro";
import {
  getManifest, getGrades, getDelegationsByState, recentChamberActivity,
} from "../lib/data";
import { formatDate } from "../lib/display";
import { STATE_NAME } from "../lib/states";

const manifest = getManifest();
const n = (x: number | unknown) => Number(x ?? 0).toLocaleString("en-US");
const c = manifest.counts as Record<string, any>;
const updated = formatDate(manifest.generated_at);

// Grade band colours mirror --color-grade-* (global.css), keyed by the ratified letter.
const GRADE_HEX: Record<string, string> = {
  A: "#7fbf9a", B: "#9184d9", C: "#c9b06a", D: "#d99a6b", F: "#d96b7a",
};
const grades = getGrades();
const att = grades.attendance;
const bandCounts = att
  ? att.bands.map((b) => ({
      grade: b.grade, label: b.label, color: GRADE_HEX[b.grade],
      count: Object.values(att.members).filter((e) => e.grade === b.grade).length,
    }))
  : [];
const histBands = att ? att.bands.map((b) => ({ grade: b.grade, min: b.min, color: GRADE_HEX[b.grade] })) : [];
const attValues = att ? Object.values(att.members).map((e) => e.value) : [];
const gradedTotal = att ? Object.keys(att.members).length : 0;
const setAside = att ? Object.keys(att.exceptions).length : 0;

// Find your representatives: members who actually hold a seat as of the dataset's
// own date, grouped by state and ordered by state NAME (§2 — state first; address
// lookup is a later phase). One picker, not 56 cards.
const delegations = getDelegationsByState();
const servingTotal = delegations.reduce((t, d) => t + d.senate.length + d.house.length, 0);
const PARTY_HEX: Record<string, string> = { D: "#6f93e6", R: "#e0736b", I: "#c9b06a" };

// In Congress: the last 14 days of floor-resolving actions, from data/events/, in
// the owner's ratified order — consequence, then how contested the vote was. One
// ranked list, not four equal-weight boxes: see recentChamberActivity().
//
// 10 rows: enough that every item the record actually put to a recorded vote clears
// the band (7 enacted + 1 failed + 1 contested passage in the window this shipped
// on), rather than the enacted items alone filling it.
const activity = recentChamberActivity(10);

// The "97% never got a floor vote" fact, kept and moved down (§2). Figures come from
// the recompute-gated manifest block; nothing is computed on this page.
const leg = (c.legislation ?? {}) as Record<string, number>;
const sponsoredTotal = leg.sponsored_bills ?? 0;
const neverVoted = leg.sponsored_without_rollcall ?? 0;
const neverPct = sponsoredTotal ? Math.round((neverVoted / sponsoredTotal) * 100) : 0;
---
<Layout
  title="Civic Ledger — what the people you vote for actually do"
  description="Find your senators and representatives, and see their record from the official account of Congress: the votes, the bills, the attendance."
>
  <!-- Top: the welcome (Q-A, owner's wording) -->
  <section class="max-w-[62ch]">
    <h1 class="text-[30px] font-medium leading-[1.15] tracking-[-0.025em] text-text sm:text-[38px]">
      Nobody should have to become an expert, or spend their life tracking
      politicians, to know what the people they vote for actually do.
    </h1>
    <p class="mt-5 text-[15px] leading-relaxed text-neutral-600">
      So this site does the tracking. It is built from the official record — the
      votes, the bills, the attendance — and it is the same record for every member
      of every party.
    </p>
  </section>

  <!-- In Congress, from the action record -->
  {activity && (
    <section class="mt-10" aria-labelledby="week-h">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 id="week-h" class="text-[20px] font-medium text-text">In Congress</h2>
        <p class="text-[12px] text-neutral-500">
          Official actions recorded {formatDate(activity.from)} – {formatDate(activity.to)}
        </p>
      </div>
      <p class="mt-2 max-w-[72ch] text-[13px] leading-relaxed text-neutral-600">
        Most consequential first: what became law, then what was killed on the floor, then
        what passed on a recorded vote — closest tally first, because the closer the vote,
        the more divided the chamber was. Every line is the government's own action text,
        word for word. Nothing here is a summary or a prediction.
        {" "}<a href="/congress" class="text-accent-300 underline decoration-accent-700 underline-offset-2 hover:text-text">How this is ordered</a>.
      </p>

      {activity.total === 0 ? (
        <p class="mt-4 text-[13px] text-neutral-600">
          No bill reached the floor in these {activity.days} days of the record.
        </p>
      ) : (
        <>
          <ol class="mt-4 max-w-[80ch] rounded-lg border border-line bg-surface px-5">
            {activity.lead.map((row) => <ActivityItem row={row} />)}
          </ol>
          {activity.total > activity.lead.length && (
            <p class="mt-3 text-[13px]">
              <a href="/congress"
                 class="text-accent-300 underline decoration-accent-700 underline-offset-2 hover:text-text">
                See all {n(activity.total)} actions in this window →
              </a>
            </p>
          )}
        </>
      )}
    </section>
  )}

  <!-- Find your representatives: one picker -->
  <section class="mt-10" aria-labelledby="reps-h">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="reps-h" class="text-[20px] font-medium text-text">Find your representatives</h2>
      <p class="text-[12px] text-neutral-500">{n(servingTotal)} members currently in office</p>
    </div>

    <div class="mt-4 rounded-lg border border-line bg-surface p-5" data-reps>
      <label for="state-pick" class="mb-1.5 block text-[11px] font-medium uppercase tracking-[0.06em] text-neutral-500">Your state</label>
      <select id="state-pick" data-reps-select
              class="w-full max-w-[340px] rounded-md border border-line bg-bg px-2.5 py-2 text-[14px] text-text">
        <option value="">Pick a state…</option>
        {delegations.map((d) => (
          <option value={d.state}>{STATE_NAME[d.state] ?? d.state}</option>
        ))}
      </select>

      <!-- Every delegation is in the page, so it works with JavaScript off (all of
           them show, as one long list). The script hides them and the picker
           reveals one. -->
      <div class="mt-4" data-reps-panels>
        {delegations.map((d) => (
          <div data-state={d.state} class="mb-5 last:mb-0">
            <h3 class="text-[13px] font-medium text-text">{STATE_NAME[d.state] ?? d.state}</h3>
            {[{ label: "Senate", list: d.senate }, { label: "House", list: d.house }].map((grp) => (
              grp.list.length > 0 && (
                <>
                  <h4 class="mt-2.5 text-[10px] font-medium uppercase tracking-[0.1em] text-neutral-500">{grp.label}</h4>
                  <ul class="mt-1.5 grid gap-1 sm:grid-cols-2 lg:grid-cols-3">
                    {grp.list.map((m) => (
                      <li>
                        <a href={`/m/${m.id}/1`}
                           class="flex items-baseline gap-2 text-[13px] text-neutral-700 underline decoration-line underline-offset-2 hover:text-text">
                          <span aria-hidden="true" class="inline-block h-2 w-2 shrink-0 rounded-full"
                                style={`background:${PARTY_HEX[m.party]}`}></span>
                          <span>{m.name}</span>
                          <span class="text-[11px] text-neutral-500">
                            {m.party}{m.district != null ? ` · District ${m.district}` : ""}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              )
            ))}
          </div>
        ))}
      </div>
      <p class="mt-4 text-[12px] text-neutral-500">
        Or <a href="/federal" class="text-accent-300 underline decoration-accent-700 underline-offset-2 hover:text-text">search every member by name →</a>
      </p>
    </div>
  </section>

  <!-- Bottom: statistics -->
  <section class="mt-10" aria-labelledby="stats-h">
    <h2 id="stats-h" class="text-[20px] font-medium text-text">The numbers behind it</h2>

    {sponsoredTotal > 0 && (
      <div class="mt-4 rounded-lg border border-line bg-surface p-6 sm:p-8">
        <div class="grid items-center gap-5 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-8">
          <span class="text-[56px] font-medium leading-none tabular-nums text-accent-300 sm:text-[80px]">{neverPct}%</span>
          <div>
            <h3 class="text-[19px] font-medium leading-snug text-text sm:text-[22px]">
              of the bills members introduced never got a floor vote.
            </h3>
            <p class="mt-2 max-w-[60ch] text-[13px] leading-relaxed text-neutral-600">
              {n(neverVoted)} of the {n(sponsoredTotal)} bills members of Congress sponsored in the
              covered Congresses never reached a recorded roll-call vote — most died in committee
              without one. Some bills still advance by voice vote or unanimous consent, which leave
              no roll call, so this counts recorded floor votes —
              {" "}<a href="/methods#floor-votes" class="text-accent-300 underline decoration-accent-700 underline-offset-2 hover:text-text">how this is counted</a>.
            </p>
          </div>
        </div>
      </div>
    )}

    {att && (
      <div class="mt-3.5 rounded-lg border border-line bg-surface p-5 sm:p-[22px]">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">Attendance, every graded member</h3>
          <span class="text-[12px] text-neutral-500">{n(gradedTotal)} members · {setAside} set aside</span>
        </div>
        <div class="mt-4">
          <Histogram values={attValues} bands={histBands} />
        </div>
        <div class="mt-5">
          <BandLegend bands={bandCounts} />
        </div>
        <p class="mt-4 max-w-[68ch] text-[12px] leading-relaxed text-neutral-500">
          Each bar counts members whose attendance falls in a 2.5-point range; bar colour
          follows the grade band of that range. Select a band to see those members. Grades
          use fixed, published thresholds —
          <a href="/methods#grade-attendance" class="text-accent-300 underline decoration-accent-700 underline-offset-2 hover:text-text">how attendance is graded</a>.
        </p>
      </div>
    )}

    <p class="mt-3.5 text-[12px] text-neutral-500">
      Dataset last updated {updated}. {n(c.rollcalls)} roll calls and {n(c.member_votes)} individual
      recorded votes across {n(c.bills)} bills —
      {" "}<a href="/methods" class="text-accent-300 underline decoration-accent-700 underline-offset-2 hover:text-text">how every figure is produced</a>.
    </p>
  </section>
</Layout>

<script>
  // Progressive enhancement for the state picker. With JavaScript off every
  // delegation stays on the page as one long list, which works; the script
  // collapses it to the one state the reader picks.
  const root = document.querySelector<HTMLElement>("[data-reps]");
  const select = root?.querySelector<HTMLSelectElement>("[data-reps-select]");
  const panels = root ? Array.from(root.querySelectorAll<HTMLElement>("[data-state]")) : [];
  if (select && panels.length) {
    const apply = () => {
      const want = select.value;
      for (const p of panels) p.hidden = want !== p.dataset.state;
    };
    apply();
    select.addEventListener("change", apply);
  }
</script>

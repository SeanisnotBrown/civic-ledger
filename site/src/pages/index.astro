---
import "../styles/global.css";

// INC-0 placeholder homepage. The real member index lands in INC-8.
// Kept deliberately free of political content (§0.5): this is UI chrome only.
const buildCommit = (import.meta.env.PUBLIC_BUILD_COMMIT ?? "dev").slice(0, 7);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A non-partisan public ledger of the legislative record." />
    <title>Civic Ledger</title>
  </head>
  <body class="min-h-screen bg-white text-neutral-900 antialiased">
    <main class="mx-auto max-w-2xl px-4 py-16">
      <h1 class="text-2xl font-semibold tracking-tight">Civic Ledger</h1>
      <p class="mt-4 text-neutral-700">
        The public record, presented without a thumb on the scale. This is the
        INC-0 scaffold — the member index, votes, bills, and quiz arrive in
        later increments.
      </p>
      <ul class="mt-8 space-y-2 text-sm text-neutral-600">
        <li>Static build; no third-party runtime requests.</li>
        <li>Quiz scoring is 100% client-side.</li>
        <li>Every published fact traces to an official source URL.</li>
      </ul>
    </main>
    <footer class="mx-auto max-w-2xl px-4 pb-16 text-xs text-neutral-500">
      <p>Build {buildCommit} · Open source · Corrections are public commits.</p>
    </footer>
  </body>
</html>

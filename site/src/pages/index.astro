---
// V2-5 landing dashboard (Nocturne redesign, D74). Discipline (§0.8) unchanged from
// the prior dashboard: colour is added around already-ratified grades; NO new
// evaluative number (no "lowest N%" cut — that is H15 round two, still owner-gated);
// a headline figure is a clickable tile ONLY when a list reproduces it. Members →
// /federal and Graded → the grade methodology both resolve to a reproducing surface;
// Roll calls and Individual votes have no single index page, so they render as
// non-clickable stats whose detail is the by-class / by-chamber cards on this page.
import Layout from "../components/Layout.astro";
import Histogram from "../components/charts/Histogram.astro";
import BandLegend from "../components/charts/BandLegend.astro";
import { getManifest, getMsManifest, getGrades } from "../lib/data";
import { ordinal, formatDate, VOTE_CLASS_LABEL } from "../lib/display";

const manifest = getManifest();
const ms = getMsManifest();
const n = (x: number | unknown) => Number(x ?? 0).toLocaleString("en-US");
const c = manifest.counts as Record<string, any>;

const congresses = manifest.congresses ?? [];
const congressLabel = congresses.length
  ? `${ordinal(congresses[0])}–${ordinal(congresses[congresses.length - 1])} Congresses`
  : "covered Congresses";

// Grade band colours mirror --color-grade-* (global.css), keyed by the ratified letter.
const GRADE_HEX: Record<string, string> = {
  A: "#7fbf9a", B: "#9184d9", C: "#c9b06a", D: "#d99a6b", F: "#d96b7a",
};
const grades = getGrades();
const att = grades.attendance;
const bandCounts = att
  ? att.bands.map((b) => ({
      grade: b.grade, label: b.label, color: GRADE_HEX[b.grade],
      count: Object.values(att.members).filter((e) => e.grade === b.grade).length,
    }))
  : [];
const histBands = att ? att.bands.map((b) => ({ grade: b.grade, min: b.min, color: GRADE_HEX[b.grade] })) : [];
const attValues = att ? Object.values(att.members).map((e) => e.value) : [];
const gradedTotal = att ? Object.keys(att.members).length : 0;
const setAside = att ? Object.keys(att.exceptions).length : 0;

const house = c.rollcalls_by_chamber?.house ?? 0;
const senate = c.rollcalls_by_chamber?.senate ?? 0;

const tiles = [
  { kicker: "Members", value: n(c.members), note: `House and Senate · ${congressLabel}`,
    href: "/federal", cta: "Browse members →" },
  { kicker: "Graded on attendance", value: n(gradedTotal),
    note: `${setAside} set aside, each with a published reason`,
    href: "/methods#grade-attendance", cta: "How grading works →" },
  { kicker: "Roll calls", value: n(c.rollcalls), note: `${n(house)} House · ${n(senate)} Senate` },
  { kicker: "Individual recorded votes", value: n(c.member_votes), note: `across ${n(c.bills)} bills` },
];

// Roll calls by class, descending; passage gets the accent, every other class a
// dimmer accent, so "procedural outnumbers passage" reads at a glance.
const classCounts = Object.entries(c.rollcalls_by_vote_class ?? {})
  .map(([k, v]) => ({
    key: k,
    label: k === "non_position" ? "Non-position" : (VOTE_CLASS_LABEL as any)[k] ?? k,
    count: v as number,
  }))
  .sort((a, b) => b.count - a.count);
const classPeak = Math.max(1, ...classCounts.map((x) => x.count));

const updated = formatDate(manifest.generated_at);

// V2-5 flagship headline (owner-ratified 2026-08-16, factual — no cutoff/grade, §0.8).
// The "97%" is a display rounding of the exact committed counts, which are shown in
// full beside it; the precise claim is "recorded roll-call vote" (voice/UC votes leave
// no roll), disclosed on /methods#floor-votes. All figures come from the recompute-
// gated manifest block (verify_recompute invariant 7); nothing computed here.
const leg = (c.legislation ?? {}) as Record<string, number>;
const sponsoredTotal = leg.sponsored_bills ?? 0;
const neverVoted = leg.sponsored_without_rollcall ?? 0;
const neverPct = sponsoredTotal ? Math.round((neverVoted / sponsoredTotal) * 100) : 0;
---
<Layout
  title="Civic Ledger — who shows up, and how they vote"
  description="A non-partisan public ledger of the U.S. Congress and state legislatures. Every vote links to its official source; attendance is graded against fixed, published thresholds."
>
  <!-- Hero -->
  <section class="grid items-end gap-6 sm:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] sm:gap-10">
    <div>
      <h1 class="text-[36px] font-medium leading-[1.05] tracking-[-0.025em] text-text sm:text-[44px]">
        Who shows up,<br />and how they vote.
      </h1>
      <p class="mt-4 max-w-[52ch] text-[15px] leading-relaxed text-neutral-600">
        A non-partisan ledger of how members of Congress and state legislatures vote.
        Every figure links to its official source. One measure is graded — attendance,
        A–F, against fixed thresholds applied the same way to every member; everything
        else is the plain recorded number, combined into no overall score.
      </p>
    </div>
    <p class="text-[13px] text-neutral-500 sm:text-right">
      Data last updated<br /><span class="text-neutral-400">{updated}</span>
    </p>
  </section>

  <!-- Flagship headline: the introduced-bill universe (V2-5) -->
  {sponsoredTotal > 0 && (
    <section class="mt-9 rounded-lg border border-line bg-surface p-6 sm:p-8" aria-labelledby="floor-h">
      <div class="grid items-center gap-5 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-8">
        <span class="text-[64px] font-medium leading-none tabular-nums text-accent-300 sm:text-[88px]">{neverPct}%</span>
        <div>
          <h2 id="floor-h" class="text-[20px] font-medium leading-snug text-text sm:text-[24px]">
            of the bills members introduced never got a floor vote.
          </h2>
          <p class="mt-2 max-w-[60ch] text-[13px] leading-relaxed text-neutral-600">
            {n(neverVoted)} of the {n(sponsoredTotal)} bills members of Congress sponsored in the
            {" "}{congressLabel} never reached a recorded roll-call vote — most died in committee
            without one. Some bills still advance by voice vote or unanimous consent, which leave
            no roll call, so this counts recorded floor votes —
            {" "}<a href="/methods#floor-votes" class="text-accent-300 underline decoration-accent-700 underline-offset-2 hover:text-text">how this is counted</a>.
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- Stat tiles -->
  <section class="mt-4 grid gap-3.5 sm:grid-cols-2 lg:grid-cols-4" aria-label="Dataset at a glance">
    {tiles.map((t) => {
      const inner = (
        <>
          <span class="text-[10px] font-medium uppercase tracking-[0.1em] text-accent-300">{t.kicker}</span>
          <span class="text-[30px] font-medium leading-none tabular-nums text-text">{t.value}</span>
          <span class="text-[12px] text-neutral-500">{t.note}</span>
          {t.cta && <span class="mt-1 text-[12px] text-accent-300">{t.cta}</span>}
        </>
      );
      return t.href ? (
        <a href={t.href}
           class="flex flex-col gap-1.5 rounded-lg border border-line bg-surface p-4 transition-shadow hover:shadow-md hover:ring-1 hover:ring-accent">
          {inner}
        </a>
      ) : (
        <div class="flex flex-col gap-1.5 rounded-lg border border-line bg-surface p-4">{inner}</div>
      );
    })}
  </section>

  <!-- Attendance histogram (flagship) -->
  {att && (
    <section class="mt-4 rounded-lg border border-line bg-surface p-5 sm:p-[22px]" aria-labelledby="dist-h">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="dist-h" class="text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">Attendance, every graded member</h2>
        <span class="text-[12px] text-neutral-500">{n(gradedTotal)} members · {setAside} set aside</span>
      </div>
      <div class="mt-4">
        <Histogram values={attValues} bands={histBands} />
      </div>
      <div class="mt-5">
        <BandLegend bands={bandCounts} />
      </div>
      <p class="mt-4 max-w-[68ch] text-[12px] leading-relaxed text-neutral-500">
        Each bar counts members whose attendance falls in a 2.5-point range; bar colour
        follows the grade band of that range. Select a band to see those members. Grades
        use fixed, published thresholds —
        <a href="/methods#grade-attendance" class="text-accent-300 underline decoration-accent-700 underline-offset-2 hover:text-text">how attendance is graded</a>.
      </p>
    </section>
  )}

  <!-- Roll-call composition + chamber/state -->
  <section class="mt-4 grid gap-3.5 lg:grid-cols-2">
    <div class="rounded-lg border border-line bg-surface p-5 sm:p-[22px]">
      <h2 class="text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">Roll calls by class</h2>
      <ul class="mt-4 space-y-2">
        {classCounts.map((x) => (
          <li class="grid grid-cols-[104px_minmax(0,1fr)_54px] items-center gap-2.5">
            <span class="truncate text-[12px] text-neutral-600">{x.label}</span>
            <span class="h-2.5 rounded-full" style={`width:${(x.count / classPeak) * 100}%;min-width:2px;background:${x.key === "passage" ? "#9184d9" : "#5d5294"}`}></span>
            <span class="text-right text-[12px] tabular-nums text-neutral-500">{n(x.count)}</span>
          </li>
        ))}
      </ul>
      <p class="mt-4 max-w-[60ch] text-[12px] leading-relaxed text-neutral-500">
        Procedural votes outnumber passage votes — which is why a bare “votes missed”
        count, without its class breakdown, can mislead.
      </p>
    </div>

    <div class="grid gap-3.5">
      <div class="rounded-lg border border-line bg-surface p-5 sm:p-[22px]">
        <h2 class="text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">Roll calls by chamber</h2>
        <div class="mt-4 space-y-3">
          {[{ label: "House", v: house }, { label: "Senate", v: senate }].map((r) => (
            <div>
              <div class="flex items-baseline justify-between text-[12px] text-neutral-600">
                <span>{r.label}</span><span class="tabular-nums text-neutral-500">{n(r.v)}</span>
              </div>
              <div class="mt-1 h-3 rounded-full" style={`width:${(r.v / Math.max(house, senate)) * 100}%;min-width:2px;background:#5d5294`}></div>
            </div>
          ))}
        </div>
      </div>

      <!-- The one saturated surface on the page (Nocturne: presence, once per page). -->
      <a href="/states" class="block rounded-lg border border-[rgba(233,233,237,0.12)] p-5 transition-shadow hover:shadow-md sm:p-[22px]" style="background:#262a60">
        <h2 class="text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-400">States</h2>
        <p class="mt-2 text-[15px] text-text">
          {ms.session_name} of the Mississippi Legislature — {n(ms.counts.members)}
          legislators, {n(ms.counts.rollcalls)} roll calls, {n(ms.counts.member_votes)} votes.
        </p>
        <p class="mt-3 text-[12px] text-accent-300">Browse states →</p>
      </a>
    </div>
  </section>
</Layout>

---
import Layout from "../components/Layout.astro";
import { getMembers } from "../lib/data";
import { ordinal } from "../lib/display";

const members = getMembers();
const house = members.filter((m) => m.chamber === "house");
const senate = members.filter((m) => m.chamber === "senate");

const PARTY_LABEL: Record<string, string> = { D: "Democrat", R: "Republican", I: "Independent" };
---
<Layout title="Civic Ledger — Members of Congress">
  <h1 class="text-2xl font-semibold tracking-tight">Members of Congress</h1>
  <p class="mt-2 max-w-prose text-neutral-700">
    The recorded legislative record for every member of the U.S. House and Senate.
    Every vote links to its official source. The site grades one measure —
    attendance — against fixed thresholds published on the methodology page, and
    applies the same standard to every member; the rest are the plain recorded
    figures, characterized by no automated writer.
  </p>

  <section class="mt-8" aria-labelledby="senate-h">
    <h2 id="senate-h" class="text-sm font-semibold uppercase tracking-wide text-neutral-500">Senate</h2>
    <ul class="mt-2 divide-y divide-neutral-100">
      {senate.map((m) => (
        <li class="py-3">
          <a href={`/m/${m.id}/1`} class="font-medium underline hover:text-neutral-800">{m.name}</a>
          <span class="ml-2 text-sm text-neutral-500">{PARTY_LABEL[m.party]} · {m.state}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-8" aria-labelledby="house-h">
    <h2 id="house-h" class="text-sm font-semibold uppercase tracking-wide text-neutral-500">House</h2>
    <ul class="mt-2 divide-y divide-neutral-100">
      {house.map((m) => (
        <li class="py-3">
          <a href={`/m/${m.id}/1`} class="font-medium underline hover:text-neutral-800">{m.name}</a>
          <span class="ml-2 text-sm text-neutral-500">
            {PARTY_LABEL[m.party]} · {m.state}{m.district != null ? `-${m.district}` : ""}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-10 border-t border-neutral-100 pt-6">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-neutral-500">
      Mississippi Legislature
    </h2>
    <p class="mt-2 max-w-prose text-sm text-neutral-700">
      The recorded roll-call record of the Mississippi state House and Senate is now
      covered too. <a href="/ms" class="underline hover:text-neutral-800">Browse the Mississippi Legislature →</a>
    </p>
  </section>

  <p class="mt-8 text-xs text-neutral-500">
    Coverage: the {ordinal(118)} and {ordinal(119)} Congresses (federal); the current
    regular session (Mississippi state).
  </p>
</Layout>

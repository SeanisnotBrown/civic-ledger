---
import Layout from "../components/Layout.astro";
import { getManifest, getMetrics, getMsManifest, getRankings, getGrades } from "../lib/data";
import { VOTE_CLASS_LABEL, VOTE_CLASS_TOOLTIP } from "../lib/display";
import type { VoteClass } from "../lib/data";

const manifest = getManifest();
const ms = getMsManifest();
const classes = Object.keys(VOTE_CLASS_LABEL) as VoteClass[];
const rollcallCount = (manifest.counts as Record<string, unknown>).rollcalls;

// One section per published metric, built from the metric functions' docstrings
// (data/metrics.json). The section set is asserted equal to the metric-key set by
// scripts/check-metrics-sections.mjs, so this page can never drift from the code.
const metrics = getMetrics();
const metricKeys = Object.keys(metrics.methodology).sort();
// Docstrings are paragraph-separated prose; render each paragraph, collapsing the
// internal line wrapping the source uses.
const paragraphs = (text: string): string[] =>
  text.split(/\n\s*\n/).map((p) => p.replace(/\s*\n\s*/g, " ").trim()).filter(Boolean);

// V2-2 rankings. One section per ranked metric (data-ranking), asserted equal to
// the ranked-metric set by check-metrics-sections.mjs. The methodology text is
// shared across metrics; party means are published here (§0.4.2(c), §6.5).
const rankings = getRankings();
const rankedKeys = Object.keys(rankings).sort();
const rankingMethodology = rankedKeys.length ? rankings[rankedKeys[0]].methodology : "";
const chamberLabel: Record<string, string> = { house: "House", senate: "Senate" };
const fmtVal = (n: number | null, isPct: boolean): string =>
  n == null ? "—" : isPct ? `${n}%` : `${n}`;

// V2-4 grades. One section per graded category, id `grade-{category}` (the member-page
// badge links here). Band ranges are derived from consecutive cutoffs; the labels are
// the exact ratified strings — check-grade-labels.mjs asserts the site renders only
// strings that appear in the config.
const grades = getGrades();
const gradeCats = Object.keys(grades).sort();
const cap = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1);
const bandRange = (bands: { min: number }[], i: number): string => {
  const lo = bands[i].min;
  const hi = i === 0 ? null : bands[i - 1].min;
  if (hi == null) return `${lo}% or above`;
  return lo === 0 ? `below ${hi}%` : `${lo}% to under ${hi}%`;
};
---
<Layout title="Methodology — Civic Ledger">
  <h1 class="text-2xl font-semibold tracking-tight">Methodology</h1>
  <p class="mt-2 max-w-prose text-neutral-700">
    This site publishes the recorded legislative record and grades one measure —
    attendance — against fixed thresholds the site's owner approved (see Grades,
    below). Every figure traces to an official source, and every grade applies the
    same published cutoffs to every member of both chambers; nothing is written,
    summarized, or characterized by an automated process. Each metric below states
    its exact formula, what it includes and excludes, and its source — the same text
    that documents the code that computes it.
  </p>

  {gradeCats.length > 0 && (
    <>
      <h2 id="grades" class="mt-8 text-sm font-semibold uppercase tracking-wide text-neutral-500">
        Grades
      </h2>
      <p class="mt-2 max-w-prose text-sm text-neutral-700">
        The site grades one measure so far — attendance — with more to come. A grade is
        a fixed judgment against lines the site's owner approved, applied identically to
        every member of both chambers; a member's grade never changes because of what
        other members do. The overall grade that would combine categories is not
        published yet — it awaits its formula.
      </p>
      <div class="mt-3 space-y-5">
        {gradeCats.map((cat) => {
          const g = grades[cat];
          return (
            <section id={`grade-${cat}`} data-grade={cat} aria-labelledby={`grade-h-${cat}`}>
              <h3 id={`grade-h-${cat}`} class="text-base font-semibold text-neutral-800">
                {cap(g.category)}
              </h3>
              <dl class="mt-1 max-w-prose space-y-1 text-sm">
                {g.bands.map((b, i) => (
                  <div class="flex gap-2">
                    <dt class="font-semibold text-neutral-800"><span data-grade-label>{b.label}</span></dt>
                    <dd class="text-neutral-500">— {bandRange(g.bands, i)}</dd>
                  </div>
                ))}
              </dl>
              <p class="mt-2 max-w-prose text-sm text-neutral-600">
                Members with fewer than {g.min_eligible} eligible roll calls are
                not graded off a thin record — they show "{g.exception_label}". Non-voting
                delegates are not graded on attendance either: they cannot vote on final
                passage, so their eligible set (about a third of roll calls) is not
                comparable to a full member's. Ratified {g.ratified}.
              </p>
            </section>
          );
        })}
      </div>
    </>
  )}

  <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-neutral-500">Metrics</h2>
  <div class="mt-2 space-y-6">
    {metricKeys.map((key) => (
      <section data-metric={key} aria-labelledby={`metric-${key}`}>
        <h3 id={`metric-${key}`} class="text-base font-semibold text-neutral-800">
          {metrics.methodology[key].label}
        </h3>
        {paragraphs(metrics.methodology[key].text).map((p) => (
          <p class="mt-1 max-w-prose text-sm text-neutral-700">{p}</p>
        ))}
      </section>
    ))}
  </div>

  {rankedKeys.length > 0 && (
    <>
      <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-neutral-500">
        Rankings &amp; percentiles
      </h2>
      {paragraphs(rankingMethodology).map((p) => (
        <p class="mt-2 max-w-prose text-sm text-neutral-700">{p}</p>
      ))}
      <div class="mt-4 space-y-5">
        {rankedKeys.map((key) => {
          const rf = rankings[key];
          const isPct = rf.value_field === "pct";
          return (
            <section data-ranking={key} aria-labelledby={`ranking-${key}`}>
              <h3 id={`ranking-${key}`} class="text-base font-semibold text-neutral-800">
                {rf.label}
              </h3>
              {["house", "senate"].map((ch) => {
                const c = rf.chambers[ch];
                if (!c || c.covered === 0) return null;
                const parties = Object.keys(c.party_means).sort();
                return (
                  <p class="mt-1 max-w-prose text-sm text-neutral-700">
                    <span class="font-medium">{chamberLabel[ch]}:</span>{" "}
                    {c.covered} ranked · chamber average {fmtVal(c.mean, isPct)},
                    median {fmtVal(c.median, isPct)}
                    {parties.length > 0 && (
                      <span>
                        {" "}· party averages{" "}
                        {parties.map((p) => `${p} ${fmtVal(c.party_means[p], isPct)}`).join(", ")}
                      </span>
                    )}
                    {c.excluded_delegates.length > 0 && (
                      <span class="text-neutral-500">
                        {" "}· {c.excluded_delegates.length} non-voting delegate
                        {c.excluded_delegates.length === 1 ? "" : "s"} not ranked here
                        (cannot vote on final passage)
                      </span>
                    )}
                  </p>
                );
              })}
            </section>
          );
        })}
      </div>
    </>
  )}

  <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-neutral-500">Sources</h2>
  <ul class="mt-2 max-w-prose list-disc space-y-1 pl-5 text-sm text-neutral-700">
    <li>House roll calls: api.congress.gov, cross-checked against clerk.house.gov XML.</li>
    <li>Senate roll calls: senate.gov LIS XML, cross-checked against the published tallies.</li>
    <li>Bills: api.congress.gov bill detail (title, sponsor, policy area, CBO links).</li>
    <li>Absence explanations: the Congressional Record, owner-reviewed and verbatim.</li>
  </ul>

  <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-neutral-500">
    Vote categories
  </h2>
  <p class="mt-1 max-w-prose text-sm text-neutral-600">
    Every roll call is placed in one procedural category by a published rules
    table. The category describes the parliamentary action, never its merits.
  </p>
  <dl class="mt-2 max-w-prose space-y-2 text-sm">
    {classes.map((c) => (
      <div>
        <dt class="font-medium text-neutral-800">{VOTE_CLASS_LABEL[c]}</dt>
        <dd class="text-neutral-600">{VOTE_CLASS_TOOLTIP[c]}</dd>
      </div>
    ))}
  </dl>

  <h2 id="mississippi" class="mt-10 border-t border-neutral-100 pt-6 text-sm font-semibold uppercase tracking-wide text-neutral-500">
    Mississippi Legislature — sources &amp; limits
  </h2>
  <p class="mt-2 max-w-prose text-sm text-neutral-700">
    The Mississippi state layer covers the {ms.session_name}
    ({Number(ms.counts.rollcalls).toLocaleString()} roll calls,
    {String(ms.counts.members)} legislators). It follows the same "publish the record,
    draw no conclusion" rules as the federal data, with these specific sources and limits:
  </p>
  <ul class="mt-2 max-w-prose list-disc space-y-2 pl-5 text-sm text-neutral-700">
    <li>
      <strong>Source and verification.</strong> State roll calls come from
      <span class="whitespace-nowrap">LegiScan</span>, which mirrors the official
      Mississippi Legislature record at <code>billstatus.ls.state.ms.us</code>. Because
      LegiScan is a mirror of that record rather than a second independent origin, we
      verify its fidelity: a sample of votes was matched person-by-person against the
      official per-vote PDFs (470 individual positions, zero mismatches), and an automated
      check re-confirms each sampled vote's official Yeas/Nays/Absent totals on every build.
      Individual roll calls link to their LegiScan vote page; bills link to the official
      Mississippi record where available.
    </li>
    <li>
      <strong>Coverage.</strong> Only the current regular session is included; earlier
      sessions are not yet published.
    </li>
    <li>
      <strong>Recorded positions.</strong> The official record distinguishes Yea, Nay, and
      not-voting only. A "Not voting" row combines members recorded absent and present-but-
      not-voting. Unlike the federal record, there is no personal-explanation process, so a
      missed state vote carries no stated reason.
    </li>
    <li>
      <strong>Party.</strong> One member is recorded by LegiScan as "Nonpartisan"; in the
      Democrat/Republican/Independent model used here that member is shown as Independent.
    </li>
    <li>
      <strong>Bills.</strong> Only measures that received a recorded roll-call vote are
      published as bill pages (not every measure introduced).
    </li>
    <li>
      <strong>Authorship &amp; statistics.</strong> Mississippi legislator pages show
      attendance, party unity, bills authored and co-authored, and how many authored
      bills the Governor approved — computed by the same formulas as the federal figures.
      Two Mississippi-specific notes: LegiScan does not mark a single primary author, so
      the first-listed author of a bill is taken as its principal ("authored") and the
      rest as "co-authored"; and "became law" counts bills whose official history records
      "Approved by Governor" this session.
    </li>
  </ul>

  <p class="mt-8 text-xs text-neutral-500">
    Coverage: {manifest.congresses.join("–")}th Congresses ·
    {String(rollcallCount)} roll calls (federal). Mississippi: {ms.session_name} ·
    {Number(ms.counts.rollcalls).toLocaleString()} roll calls.
  </p>
</Layout>

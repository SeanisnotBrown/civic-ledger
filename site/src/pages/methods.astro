---
// V2-5 Nocturne — Methodology (README screen 7). Named Nocturne tokens (not the neutral-
// ramp fallback), Nocturne weights (400/500 only). The Grades section is the redesigned
// piece: a bands TABLE (dot + verbatim ratified label + numeric range + population bar +
// count) and a "Set aside" card listing all 10 exceptions by name with a human-readable
// reason. Everything evaluative is READ from committed data — band labels render verbatim
// inside <span data-grade-label> (check-grade-labels scans this page), band ranges come
// from consecutive ratified cutoffs, and the population counts are the same neutral
// distribution the dashboard already publishes (no band promoted, §0.8). The metric- and
// ranking-section sets are still asserted equal to the code by check-metrics-sections, so
// the data-metric / data-ranking sections and the #grade-attendance / #mississippi anchors
// are preserved.
import Layout from "../components/Layout.astro";
import { getManifest, getMetrics, getMsManifest, getRankings, getGrades, getMembers } from "../lib/data";
import { VOTE_CLASS_LABEL, VOTE_CLASS_TOOLTIP } from "../lib/display";
import { MOTIONS } from "../lib/motions";
import type { VoteClass } from "../lib/data";

const manifest = getManifest();
const ms = getMsManifest();
const classes = Object.keys(VOTE_CLASS_LABEL) as VoteClass[];
const rollcallCount = (manifest.counts as Record<string, unknown>).rollcalls;
// V2-5 dashboard-headline disclosure (recompute-gated manifest block; see /). Exact
// counts drive the copy so it can never drift from the published figure.
const legc = ((manifest.counts as Record<string, any>).legislation ?? {}) as Record<string, number>;
const legTotal = legc.sponsored_bills ?? 0;
const legNever = legc.sponsored_without_rollcall ?? 0;
const legPct = legTotal ? Math.round((legNever / legTotal) * 100) : 0;
const congressRange = (manifest.congresses ?? []).join("–");

const metrics = getMetrics();
const metricKeys = Object.keys(metrics.methodology).sort();
const paragraphs = (text: string): string[] =>
  text.split(/\n\s*\n/).map((p) => p.replace(/\s*\n\s*/g, " ").trim()).filter(Boolean);

const rankings = getRankings();
const rankedKeys = Object.keys(rankings).sort();
const rankingMethodology = rankedKeys.length ? rankings[rankedKeys[0]].methodology : "";
const chamberLabel: Record<string, string> = { house: "House", senate: "Senate" };
const fmtVal = (n: number | null, isPct: boolean): string =>
  n == null ? "—" : isPct ? `${n}%` : `${n}`;

// V2-4 grades → bands table + set-aside card (V2-5 redesign).
const grades = getGrades();
const gradeCats = Object.keys(grades).sort();
const cap = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1);
const bandRange = (bands: { min: number }[], i: number): string => {
  const lo = bands[i].min;
  const hi = i === 0 ? null : bands[i - 1].min;
  if (hi == null) return `${lo}% or above`;
  return lo === 0 ? `below ${hi}%` : `${lo}% to under ${hi}%`;
};
const GRADE_COLOR: Record<string, string> = {
  A: "var(--color-grade-a)", B: "var(--color-grade-b)", C: "var(--color-grade-c)",
  D: "var(--color-grade-d)", F: "var(--color-grade-f)",
};
const REASON_LABEL: Record<string, string> = {
  delegate: "Non-voting delegate", min_service: "Too little service", no_record: "No eligible record",
};
const nameOf = new Map(getMembers().map((m) => [m.id, m.name]));
// per-category band population counts + the set-aside list (named), computed from the
// committed grades export — never typed in.
const gradeView = gradeCats.map((cat) => {
  const g = grades[cat];
  const counts: Record<string, number> = {};
  for (const e of Object.values(g.members)) counts[e.grade] = (counts[e.grade] ?? 0) + 1;
  const maxCount = Math.max(1, ...Object.values(counts));
  const setAside = Object.entries(g.exceptions)
    .map(([id, reason]) => ({ id, name: nameOf.get(id) ?? id, reason, label: REASON_LABEL[reason] ?? reason }))
    .sort((a, b) => a.name.localeCompare(b.name));
  return { cat, g, counts, maxCount, setAside };
});
const n = (x: number) => x.toLocaleString("en-US");

// The motion table, read from the module the pages render from, so this page and
// the vote rows can never disagree. The two resolution lines are chosen from the
// measure's own title at render time, so the row here says so rather than
// printing one of them as if it were the only one.
const MOTION_LABEL: Record<string, string> = {
  table: "Motion to table",
  waiver: "Motion to waive a rule",
  veto_override: "Passage over the President's veto",
  cloture: "Cloture",
  previous_question: "Ordering the previous question",
  recommit: "Motion to recommit",
  discharge: "Motion to discharge a committee",
  instruct_conferees: "Conference negotiation",
  commit: "Motion to commit or refer",
  reconsider: "Motion to reconsider",
  suspension: "Suspension of the rules",
  concur: "Motion to concur in the other chamber's version",
  proceed: "Motion to proceed",
  nomination: "Confirmation of a nomination",
  amendment: "Amendment",
  adjourn: "Motion to adjourn",
  conference_report: "Conference report",
  passage: "Passage",
  resolution: "Agreeing to a resolution",
  point_of_order: "Point of order",
  housekeeping: "The chamber's own proceedings",
};
const motionRows = MOTIONS.map((m) => ({
  label: MOTION_LABEL[m.kind] ?? m.kind,
  meaning: m.meaning,
  kind: m.kind,
}));
---
<Layout title="Methodology — Civic Ledger">
  <h1 class="text-[32px] font-medium tracking-[-0.025em]">Methodology</h1>
  <p class="mt-2 max-w-[62ch] text-[15px] leading-[1.6] text-neutral-700">
    This site publishes the recorded legislative record and grades one measure — attendance
    — against fixed thresholds the site's owner approved (see Grades, below). Every figure
    traces to an official source, and every grade applies the same published cutoffs to
    every member of both chambers; nothing is written, summarized, or characterized by an
    automated process. Each metric below states its exact formula, what it includes and
    excludes, and its source — the same text that documents the code that computes it.
  </p>

  {gradeView.length > 0 && (
    <>
      <h2 id="grades" class="mt-9 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">Grades</h2>
      <p class="mt-2 max-w-[62ch] text-[14px] leading-relaxed text-neutral-700">
        The site grades one measure so far — attendance — with more to come. A grade is a
        fixed judgment against lines the site's owner approved, applied identically to every
        member of both chambers; a member's grade never changes because of what other members
        do. The overall grade that would combine categories is not published yet — it awaits
        its formula.
      </p>
      {gradeView.map(({ cat, g, counts, maxCount, setAside }) => (
        <section id={`grade-${cat}`} data-grade={cat} aria-labelledby={`grade-h-${cat}`} class="mt-4 rounded-lg border border-line bg-surface p-5">
          <h3 id={`grade-h-${cat}`} class="text-[15px] font-medium text-text">{cap(g.category)}</h3>
          <!-- Bands table: dot + verbatim label | range | population bar | count. Wrapped
               in a horizontal scroller so the fixed label/range columns don't overflow the
               page body at 380px (the mobile e2e gate) — same pattern as /federal. -->
          <div class="mt-3 overflow-x-auto" tabindex="0" role="region" aria-label={`${cap(g.category)} grade bands`}>
          <div class="min-w-[400px] space-y-2">
            {g.bands.map((b, i) => {
              const count = counts[b.grade] ?? 0;
              return (
                <div class="grid items-center gap-3" style="grid-template-columns:150px 128px minmax(0,1fr) 44px">
                  <div class="flex items-center gap-2 text-[13px] text-text">
                    <span aria-hidden="true" class="inline-block h-[10px] w-[10px] rounded-full" style={`background:${GRADE_COLOR[b.grade]}`}></span>
                    <span data-grade-label>{b.label}</span>
                  </div>
                  <div class="text-[12px] tabular-nums text-neutral-500">{bandRange(g.bands, i)}</div>
                  <div class="h-2 rounded" style="background:var(--color-track)">
                    <div class="h-2 rounded" style={`width:${(count / maxCount) * 100}%;background:${GRADE_COLOR[b.grade]};opacity:0.9`}></div>
                  </div>
                  <div class="text-right text-[12px] tabular-nums text-neutral-600">{n(count)}</div>
                </div>
              );
            })}
          </div>
          </div>
          <p class="mt-3 max-w-[62ch] text-[12px] leading-relaxed text-neutral-500">
            Members with fewer than {g.min_eligible} eligible roll calls are not graded off a
            thin record. Non-voting delegates are not graded on attendance either: they cannot
            vote on final passage, so their eligible set (about a third of roll calls) is not
            comparable to a full member's. Ratified {g.ratified}.
          </p>

          {setAside.length > 0 && (
            <div class="mt-4 border-t border-line-soft pt-3">
              <h4 class="text-[11px] font-medium uppercase tracking-[0.06em] text-neutral-500">Set aside ({setAside.length})</h4>
              <ul class="mt-2 grid gap-x-6 gap-y-1 sm:grid-cols-2">
                {setAside.map((s) => (
                  <li class="flex items-baseline justify-between gap-2 text-[13px]">
                    <a href={`/m/${s.id}/1`} class="text-text hover:text-accent-300">{s.name}</a>
                    <span class="text-[12px] text-neutral-500">{s.label}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))}
    </>
  )}

  <h2 class="mt-9 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">Metrics</h2>
  <div class="mt-3 space-y-6">
    {metricKeys.map((key) => (
      <section data-metric={key} aria-labelledby={`metric-${key}`}>
        <h3 id={`metric-${key}`} class="text-[15px] font-medium text-text">{metrics.methodology[key].label}</h3>
        {paragraphs(metrics.methodology[key].text).map((p) => (
          <p class="mt-1 max-w-[62ch] text-[14px] leading-relaxed text-neutral-700">{p}</p>
        ))}
      </section>
    ))}
  </div>

  {legTotal > 0 && (
    <section id="floor-votes" aria-labelledby="floor-votes-h">
      <h2 id="floor-votes-h" class="mt-9 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">Bills and floor votes</h2>
      <div class="mt-3 space-y-3 max-w-[62ch] text-[14px] leading-relaxed text-neutral-700">
        <p>
          The dashboard headline — <strong class="font-medium text-text">{legPct}% of the bills
          members introduced never got a floor vote</strong> — counts every distinct bill
          sponsored by a covered member across the {congressRange}th Congresses:
          {" "}{n(legTotal)} bills in all.
          A bill is counted as having reached a floor vote only if it appears in our roll-call
          data as the subject of a recorded vote; {n(legc.sponsored_with_rollcall)} did, so
          {" "}{n(legNever)} did not. Most of those never left committee. The count spans every
          measure a member can sponsor — House and Senate bills and joint, concurrent, and simple
          resolutions; limiting it to the bills that can actually become law (House and Senate
          bills and joint resolutions) leaves the share essentially unchanged.
        </p>
        <p>
          “Floor vote” here means a <strong class="font-medium text-text">recorded roll-call
          vote</strong>, and that precision matters: a bill can still pass the floor by voice
          vote or unanimous consent, which leave no roll call. That is not a rare edge case —
          of the {n(legc.sponsored_became_law)} of these bills that became law,
          {" "}{n(legc.became_law_without_rollcall)} did so without ever appearing in our
          roll-call data. So the figure describes recorded floor votes, not whether a bill
          received any consideration at all.
        </p>
        <p>
          This is a plain count of the public record — no threshold, no grade, and no member is
          singled out. It is derived from the committed dataset, and a continuous-integration
          check re-derives it from that data on every change; a number that could not be
          reproduced from the published data would not appear here.
        </p>
      </div>
    </section>
  )}

  <section id="motions" aria-labelledby="motions-h">
    <h2 id="motions-h" class="mt-9 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">
      What a vote decided
    </h2>
    <div class="mt-3 max-w-[62ch] space-y-3 text-[14px] leading-relaxed text-neutral-700">
      <p>
        A roll call's question is the chamber's own wording, and that wording is
        procedural. “On Motion to Table” is one of the most common: a Yea on a motion to
        table sets the matter aside without the chamber ever voting on its merits. Read
        without the procedure, such a row looks like a vote in favour of the thing that
        was set aside.
      </p>
      <p>
        So each vote row carries one plain-English line saying what a Yea and a Nay on
        that motion did. Those lines come from the fixed table below, matched against the
        question text, first match wins. They are written once, by hand, and they are the
        same line for every member and every bill. No line is generated at build time,
        and none is produced by an automated summary of the vote. A question the table
        does not cover gets no line at all rather than a guess.
      </p>
      <p>
        The lines describe the procedure, never a member's reason for voting as they did,
        and they state no threshold the record does not carry: the Senate's cloture
        requirement differs between legislation and nominations, so no number is printed
        there, while suspension of the rules carries the same two-thirds requirement every
        time it is used, so that one is stated.
      </p>
    </div>
    <div class="mt-4 max-w-[80ch] overflow-x-auto">
      <table class="w-full border-collapse text-left text-[13px]">
        <caption class="sr-only">Each motion type and the line published on its vote rows</caption>
        <thead>
          <tr class="border-b border-line">
            <th scope="col" class="py-2 pr-4 align-top text-[11px] font-medium uppercase tracking-[0.08em] text-neutral-500">Motion</th>
            <th scope="col" class="py-2 align-top text-[11px] font-medium uppercase tracking-[0.08em] text-neutral-500">The line published on the row</th>
          </tr>
        </thead>
        <tbody>
          {motionRows.map((r) => (
            <tr class="border-b border-line-soft align-top">
              <th scope="row" class="w-[28%] min-w-[9rem] py-2 pr-4 font-medium text-text">{r.label}</th>
              <td class="py-2 leading-relaxed text-neutral-700">
                {r.meaning
                  ? r.meaning
                  : "Two lines, chosen from the measure's own official title: a House resolution whose title opens \u201cProviding for consideration of\u201d sets the terms for debating another bill, and any other resolution is the vote on the resolution itself."}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 max-w-[62ch] text-[12px] leading-relaxed text-neutral-500">
      The table is matched in the order shown, so the outer motion always wins: a vote on a
      motion to table a motion to discharge a committee is a tabling vote, and a vote on
      cloture on a motion to proceed is a cloture vote.
    </p>
  </section>

  <section id="sources" aria-labelledby="sources-h">
    <h2 id="sources-h" class="mt-9 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">
      Where the data comes from
    </h2>
    <div class="mt-3 max-w-[62ch] space-y-3 text-[14px] leading-relaxed text-neutral-700">
      <p>
        Every figure on this site is derived from an official U.S. government record. There
        is no third-party rating, no editorial dataset, and no number typed in by hand.
        Each individual page links to the record behind it: a vote row links to the
        chamber's own roll-call page, a bill links to its page on congress.gov.
      </p>
      <ul class="list-disc space-y-1.5 pl-5">
        <li>
          <strong class="font-medium text-text">Bills, actions, members and nominations</strong> —
          the Library of Congress API at
          <a href="https://api.congress.gov" rel="nofollow" class="text-accent-300 underline underline-offset-2">api.congress.gov</a>,
          the machine interface to congress.gov.
        </li>
        <li>
          <strong class="font-medium text-text">House roll-call votes</strong> — the Clerk of
          the House, at
          <a href="https://clerk.house.gov/Votes" rel="nofollow" class="text-accent-300 underline underline-offset-2">clerk.house.gov</a>.
        </li>
        <li>
          <strong class="font-medium text-text">Senate roll-call votes</strong> — the Senate's
          own published vote records at
          <a href="https://www.senate.gov/legislative/votes_new.htm" rel="nofollow" class="text-accent-300 underline underline-offset-2">senate.gov</a>.
        </li>
        <li>
          <strong class="font-medium text-text">Stated reasons for an absence</strong> — the
          Congressional Record, published by the Government Publishing Office. A member's
          words are quoted verbatim or the row says “No explanation on record.”
        </li>
        <li>
          <strong class="font-medium text-text">Photographs, committee seats and biographical
          identifiers</strong> — the public-domain
          <a href="https://github.com/unitedstates/congress-legislators" rel="nofollow" class="text-accent-300 underline underline-offset-2">unitedstates/congress-legislators</a>
          project, whose photographs are Government Publishing Office portraits.
        </li>
      </ul>
      <p>
        The full contract for each source — its licence, its exact URL pattern, and what
        this site does and does not collect from it — is in
        <a href="https://github.com/SeanisnotBrown/civic-ledger/blob/master/docs/data-contract.md" rel="nofollow" class="text-accent-300 underline underline-offset-2">docs/data-contract.md</a>
        in the repository.
      </p>
    </div>
  </section>

  <section id="party-majority" aria-labelledby="party-majority-h">
    <h2 id="party-majority-h" class="mt-9 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">
      Whose majority a member sided with
    </h2>
    <div class="mt-3 max-w-[62ch] space-y-3 text-[14px] leading-relaxed text-neutral-700">
      <p>
        Each member page places every one of their recorded votes into one of four
        groups: with the Democratic majority only, with the Republican majority only,
        with both, or against both. The rule is mechanical and uses nothing but the roll
        call's own per-party tallies and the member's own position.
      </p>
      <ul class="list-disc space-y-1.5 pl-5">
        <li>
          A party's <strong class="font-medium text-text">majority side</strong> on a roll
          call is whichever of yea or nay that party cast more of. If a party splits
          exactly evenly, it has no majority on that roll call and nothing to side with.
        </li>
        <li>
          The member <strong class="font-medium text-text">sided with</strong> a party when
          their own position is that party's majority side.
        </li>
        <li>
          A position of “present”, or an absence, takes no side, so those votes are placed
          in no group. Neither are roll calls with no yea/nay tallies at all — an election
          for Speaker, for instance, where members vote by name.
        </li>
        <li>
          Only the Democratic and Republican tallies are read, because those are the two
          caucusing majorities. An independent member is placed by exactly the same rule as
          everyone else.
        </li>
      </ul>
      <p>
        That is the whole calculation. No outside rating is used, nothing is modelled, and
        the four counts are the entire result — the site derives no single left-to-right
        score from them, because the record does not contain one.
      </p>
    </div>
  </section>

  {rankedKeys.length > 0 && (
    <>
      <h2 class="mt-9 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">Rankings &amp; percentiles</h2>
      {paragraphs(rankingMethodology).map((p) => (
        <p class="mt-2 max-w-[62ch] text-[14px] leading-relaxed text-neutral-700">{p}</p>
      ))}
      <div class="mt-3 space-y-5">
        {rankedKeys.map((key) => {
          const rf = rankings[key];
          const isPct = rf.value_field === "pct";
          return (
            <section data-ranking={key} aria-labelledby={`ranking-${key}`}>
              <h3 id={`ranking-${key}`} class="text-[15px] font-medium text-text">{rf.label}</h3>
              {["house", "senate"].map((ch) => {
                const c = rf.chambers[ch];
                if (!c || c.covered === 0) return null;
                const parties = Object.keys(c.party_means).sort();
                return (
                  <p class="mt-1 max-w-[62ch] text-[14px] leading-relaxed text-neutral-700">
                    <span class="font-medium text-text">{chamberLabel[ch]}:</span>{" "}
                    {c.covered} ranked · chamber average {fmtVal(c.mean, isPct)}, median {fmtVal(c.median, isPct)}
                    {parties.length > 0 && (
                      <span>{" "}· party averages {parties.map((p) => `${p} ${fmtVal(c.party_means[p], isPct)}`).join(", ")}</span>
                    )}
                    {c.excluded_delegates.length > 0 && (
                      <span class="text-neutral-500">
                        {" "}· {c.excluded_delegates.length} non-voting delegate{c.excluded_delegates.length === 1 ? "" : "s"} not ranked here (cannot vote on final passage)
                      </span>
                    )}
                  </p>
                );
              })}
            </section>
          );
        })}
      </div>
    </>
  )}

  <h2 class="mt-9 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">Sources</h2>
  <ul class="mt-2 max-w-[62ch] list-disc space-y-1 pl-5 text-[14px] text-neutral-700">
    <li>House roll calls: api.congress.gov, cross-checked against clerk.house.gov XML.</li>
    <li>Senate roll calls: senate.gov LIS XML, cross-checked against the published tallies.</li>
    <li>Bills: api.congress.gov bill detail (title, sponsor, policy area, CBO links).</li>
    <li>
      Absence explanations: the Congressional Record, owner-reviewed and verbatim. These
      are currently collected for Mississippi's members of Congress only; for every other
      member a missed vote reads "No explanation on record" whether or not one was filed.
    </li>
  </ul>

  <h2 class="mt-9 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">Vote categories</h2>
  <p class="mt-1 max-w-[62ch] text-[14px] leading-relaxed text-neutral-600">
    Every roll call is placed in one procedural category by a published rules table. The
    category describes the parliamentary action, never its merits.
  </p>
  <dl class="mt-2 max-w-[62ch] space-y-2 text-[14px]">
    {classes.map((c) => (
      <div>
        <dt class="font-medium text-text">{VOTE_CLASS_LABEL[c]}</dt>
        <dd class="text-neutral-600">{VOTE_CLASS_TOOLTIP[c]}</dd>
      </div>
    ))}
  </dl>

  <h2 id="mississippi" class="mt-10 border-t border-line pt-6 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">
    Mississippi Legislature — sources &amp; limits
  </h2>
  <p class="mt-2 max-w-[62ch] text-[14px] leading-relaxed text-neutral-700">
    The Mississippi state layer covers the {ms.session_name}
    ({Number(ms.counts.rollcalls).toLocaleString()} roll calls,
    {String(ms.counts.members)} legislators). It follows the same "publish the record, draw
    no conclusion" rules as the federal data, with these specific sources and limits:
  </p>
  <ul class="mt-2 max-w-[62ch] list-disc space-y-2 pl-5 text-[14px] text-neutral-700">
    <li>
      <strong class="font-medium text-text">Source and verification.</strong> State roll calls come from
      <span class="whitespace-nowrap">LegiScan</span>, which mirrors the official Mississippi
      Legislature record at <code class="text-neutral-500">billstatus.ls.state.ms.us</code>. Because LegiScan is a
      mirror of that record rather than a second independent origin, we verify its fidelity: a
      sample of votes was matched person-by-person against the official per-vote PDFs (470
      individual positions, zero mismatches), and an automated check re-confirms each sampled
      vote's official Yeas/Nays/Absent totals on every build. Individual roll calls link to
      their LegiScan vote page; bills link to the official Mississippi record where available.
    </li>
    <li>
      <strong class="font-medium text-text">Coverage.</strong> Every regular session this site
      has ingested is included, and a legislator's Mississippi numbers cover all of them — the
      same way their federal numbers cover every covered Congress, not just the current one.
      Special sessions are not included. The session or sessions covered are named on the
      Mississippi landing page.
    </li>
    <li>
      <strong class="font-medium text-text">Recorded positions.</strong> The official record distinguishes Yea, Nay,
      and not-voting only. A "Not voting" row combines members recorded absent and present-but-
      not-voting. Unlike the federal record, there is no personal-explanation process, so a
      missed state vote carries no stated reason.
    </li>
    <li>
      <strong class="font-medium text-text">Party.</strong> One member is recorded by LegiScan as "Nonpartisan"; in
      the Democrat/Republican/Independent model used here that member is shown as Independent.
    </li>
    <li><strong class="font-medium text-text">Bills.</strong> Only measures that received a recorded roll-call vote are published as bill pages (not every measure introduced).</li>
    <li>
      <strong class="font-medium text-text">Authorship &amp; statistics.</strong> Mississippi legislator pages show
      attendance, party unity, bills authored and co-authored, and how many authored bills the
      Governor approved — computed by the same formulas as the federal figures. Two Mississippi-
      specific notes: LegiScan does not mark a single primary author, so the first-listed author
      of a bill is taken as its principal ("authored") and the rest as "co-authored"; and
      "became law" counts bills whose official history records "Approved by Governor" this session.
    </li>
  </ul>

  <p class="mt-8 text-[12px] text-neutral-500">
    Coverage: {manifest.congresses.join("–")}th Congresses ·
    {String(rollcallCount)} roll calls (federal). Mississippi: {ms.session_name} ·
    {Number(ms.counts.rollcalls).toLocaleString()} roll calls.
  </p>
</Layout>

---
import Layout from "../../../components/Layout.astro";
import { getMsBills, getMsBill, getMsVotesForBill, getMsMember } from "../../../lib/data";
import { formatDate, msBillLabel } from "../../../lib/display";

export function getStaticPaths() {
  return getMsBills().map((b) => ({ params: { bill: b.id }, props: { billId: b.id } }));
}

interface Props { billId: string }
const { billId } = Astro.props as Props;
const bill = getMsBill(billId)!;
const rolls = getMsVotesForBill(billId);
const sponsor = bill.sponsor_id ? getMsMember(bill.sponsor_id) : undefined;
const cosponsors = (bill.cosponsor_ids ?? []).map((id) => ({ id, m: getMsMember(id) }));
---
<Layout title={`${msBillLabel(bill.id)} — Mississippi Legislature — Civic Ledger`}>
  <nav class="text-xs text-neutral-500">
    <a href="/ms" class="underline decoration-line underline-offset-2 hover:text-text">Mississippi Legislature</a> / {msBillLabel(bill.id)}
  </nav>
  <h1 class="mt-1 text-xl font-medium tracking-tight text-text">{msBillLabel(bill.id)}</h1>
  <p class="mt-1 text-text">{bill.title_official}</p>

  <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
    <a href={bill.source_url} rel="nofollow" class="text-accent-300 underline underline-offset-2">Official record</a>
    {bill.latest_action && <span class="text-neutral-500">Latest action: {bill.latest_action}{bill.latest_action_date ? ` (${formatDate(bill.latest_action_date)})` : ""}</span>}
  </div>

  {sponsor && (
    <p class="mt-4 text-sm">
      <span class="text-neutral-500">Primary sponsor:</span>{" "}
      <a href={`/ms/m/${sponsor.id}/1`} class="text-accent-300 underline underline-offset-2">{sponsor.name}</a>
    </p>
  )}
  {cosponsors.length > 0 && (
    <p class="mt-1 text-sm text-neutral-600">
      <span class="text-neutral-500">Cosponsors ({cosponsors.length}):</span>{" "}
      {cosponsors.map(({ id, m }, i) => (
        <>{i > 0 ? ", " : ""}<a href={`/ms/m/${id}/1`} class="text-accent-300 underline underline-offset-2">{m?.name ?? id}</a></>
      ))}
    </p>
  )}
  {bill.subjects && bill.subjects.length > 0 && (
    <p class="mt-2 text-sm text-neutral-600">
      <span class="text-neutral-500">Subjects:</span> {bill.subjects.join(", ")}
    </p>
  )}

  <h2 class="mt-8 text-[11px] font-medium uppercase tracking-[0.1em] text-neutral-500">
    Roll-call votes on this measure
  </h2>
  {rolls.length === 0 ? (
    <p class="mt-1 text-sm text-neutral-600">No recorded roll-call votes reference this measure.</p>
  ) : (
    <ul class="mt-2 divide-y divide-line-soft">
      {rolls.map((rc) => (
        <li class="py-2 text-sm">
          <a href={`/ms/v/${rc.id}`} class="text-accent-300 underline underline-offset-2">{rc.question}</a>
          <span class="ml-2 text-neutral-500">{formatDate(rc.date)} · {rc.result}</span>
        </li>
      ))}
    </ul>
  )}
</Layout>

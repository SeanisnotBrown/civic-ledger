---
import Layout from "../../../components/Layout.astro";
import Badge from "../../../components/Badge.astro";
import { getAllMsVotes, getMsMember } from "../../../lib/data";
import type { VoteFile, Position } from "../../../lib/data";
import { POSITION_LABEL, formatDate, msBillLabel } from "../../../lib/display";

export function getStaticPaths() {
  return getAllMsVotes().map((v) => ({ params: { roll: v.rollcall.id }, props: { vote: v } }));
}

interface Props { vote: VoteFile }
const { vote } = Astro.props as Props;
const rc = vote.rollcall;
const chamber = rc.chamber === "house" ? "House" : "Senate";

// Group the member positions by vote for a readable roll page, each sorted by name.
const GROUPS: Position[] = ["yea", "nay", "present", "not_voting"];
const byPosition = new Map<Position, { id: string; name: string }[]>();
for (const g of GROUPS) byPosition.set(g, []);
for (const mv of vote.member_votes) {
  const m = getMsMember(mv.member_id);
  byPosition.get(mv.position)!.push({ id: mv.member_id, name: m?.name ?? mv.member_id });
}
for (const g of GROUPS) byPosition.get(g)!.sort((a, b) => a.name.localeCompare(b.name));
---
<Layout title={`Mississippi ${chamber} Roll #${rc.number} — Civic Ledger`}>
  <nav class="text-xs text-neutral-500">
    <a href="/ms" class="underline">Mississippi Legislature</a> / Roll call
  </nav>
  <div class="mt-1 flex flex-wrap items-center gap-2">
    <h1 class="text-xl font-semibold tracking-tight">Mississippi {chamber} Roll #{rc.number}</h1>
    <Badge voteClass={rc.vote_class} />
  </div>
  <p class="mt-1 text-sm text-neutral-500">{formatDate(rc.date)}</p>

  <h2 class="mt-6 text-sm font-semibold uppercase tracking-wide text-neutral-500">Question</h2>
  <p class="mt-1 text-neutral-900">{rc.question}</p>
  <p class="mt-2 text-sm text-neutral-600">Result: {rc.result}</p>
  <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
    {rc.bill_id && (
      <a href={`/ms/b/${rc.bill_id}`} class="underline hover:text-neutral-800">{msBillLabel(rc.bill_id)}</a>
    )}
    <a href={rc.source_url} rel="nofollow" class="underline hover:text-neutral-800">Vote record (LegiScan)</a>
  </div>

  <h2 class="mt-6 text-sm font-semibold uppercase tracking-wide text-neutral-500">Totals</h2>
  <ul class="mt-1 flex flex-wrap gap-x-6 text-sm text-neutral-700">
    {GROUPS.map((k) => (
      <li>{POSITION_LABEL[k]}: <span class="font-medium">{rc.totals[k] ?? 0}</span></li>
    ))}
  </ul>

  <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-neutral-500">Positions</h2>
  {GROUPS.filter((g) => byPosition.get(g)!.length > 0).map((g) => (
    <section class="mt-3">
      <h3 class="text-sm font-medium text-neutral-700">{POSITION_LABEL[g]} ({byPosition.get(g)!.length})</h3>
      <ul class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {byPosition.get(g)!.map((p) => (
          <li><a href={`/ms/m/${p.id}/1`} class="underline hover:text-neutral-800">{p.name}</a></li>
        ))}
      </ul>
    </section>
  ))}
</Layout>
